{
  "components": {
    "schemas": {
      "Input": {
        "properties": {
          "draft_id": {
            "description": "The id of a completed Seedance 2.5 draft (the draft's prediction id, returned as draft_id when the draft was generated with draft=true on bytedance/seedance-2.5/text-to-video, image-to-video or reference-to-video). The final is rendered at 1080p or 4k from the draft's own prompt, inputs, duration, aspect ratio, seed and audio settings; do not send those fields again. A draft can be completed any number of times within 7 days of its creation; each completion is a separate task.",
            "type": "string"
          },
          "model": {
            "default": "bytedance/seedance-2.5/draft-complete",
            "description": "Model name.",
            "type": "string"
          },
          "output_format": {
            "default": "mp4",
            "description": "Output video container format. 'mp4' is the default; 'mov' encodes yuv444p for higher color fidelity, suited to multi-round editing/extension pipelines where recompression loss accumulates.",
            "enum": [
              "mp4",
              "mov"
            ],
            "type": "string"
          },
          "resolution": {
            "default": "1080p",
            "description": "Video resolution. 1080p or 4k are native Seedance outputs.",
            "enum": [
              "1080p",
              "4k"
            ],
            "type": "string"
          },
          "return_last_frame": {
            "default": false,
            "description": "Whether to return the last frame as a separate image.",
            "type": "boolean"
          },
          "watermark": {
            "default": false,
            "description": "Whether to add a watermark.",
            "type": "boolean"
          }
        },
        "required": [
          "model",
          "draft_id",
          "resolution"
        ],
        "type": "object",
        "x-order-properties": [
          "model",
          "draft_id",
          "resolution",
          "output_format",
          "watermark",
          "return_last_frame"
        ]
      },
      "PredictionData": {
        "properties": {
          "completion_tokens": {
            "description": "Tokens consumed for billing.",
            "type": "integer"
          },
          "created_at": {
            "description": "ISO timestamp of creation.",
            "format": "date-time",
            "type": "string"
          },
          "draft_id": {
            "description": "The draft this task was completed from.",
            "type": "string"
          },
          "has_nsfw_contents": {
            "description": "NSFW detection per output.",
            "items": {
              "type": "boolean"
            },
            "type": "array"
          },
          "id": {
            "description": "Unique identifier for the prediction.",
            "type": "string"
          },
          "model": {
            "description": "Model ID used for the prediction.",
            "type": "string"
          },
          "outputs": {
            "description": "URLs to generated content (video + optional last frame).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "description": "Status: processing, completed, failed, or timeout.",
            "type": "string"
          },
          "total_tokens": {
            "description": "Total tokens consumed.",
            "type": "integer"
          },
          "urls": {
            "description": "Object containing related API endpoints.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "PredictionResponse": {
        "properties": {
          "code": {
            "type": "integer"
          },
          "data": {
            "$ref": "#/components/schemas/PredictionData"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Seedance 2.5 draft completion: render the 1080p or 4k final of a completed draft.",
    "title": "AtlasCloud API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/model/generateVideo": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "The request status."
          }
        }
      },
      "x-api-name": "model_run"
    },
    "/api/v1/model/prediction/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      },
      "x-api-name": "model_result"
    }
  },
  "servers": [
    {
      "url": "https://api.atlascloud.ai"
    }
  ]
}
