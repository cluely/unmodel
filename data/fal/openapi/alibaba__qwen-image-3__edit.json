        "QwenImage3EditInput": {
          "description": "Input for Qwen Image 3 image editing with reference images.",
          "properties": {
            "enable_prompt_expansion": {
              "default": true,
              "description": "Enable automatic LLM prompt rewriting for better results.",
              "title": "Enable Prompt Expansion",
              "type": "boolean"
            },
            "enable_safety_checker": {
