  "metadata": {
    "category": "image-to-video",
    "date": "2026-11-15T04:58:15.189Z",
    "description": "Dreamina Seedance 2.5 Flash is the fast tier of Seedance 2.5. It generates, edits and extends video from up to 10 images, 5 videos and 5 audio references at 480p or 720p.",
    "display_name": "Seedance 2.5 Flash Reference to Video",
    "group": {
      "key": "sd25flash",
      "label": "Reference to Video"
    },
    "highlighted": false,
    "is_favorited": null,
    "kind": "inference",
    "license_type": "commercial",
    "model_url": "https://fal.run/bytedance/seedance-2.5/flash/reference-to-video",
    "pinned": false,
    "status": "active",
