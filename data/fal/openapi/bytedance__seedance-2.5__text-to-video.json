                "standard",
                "high"
              ],
              "examples": [
                "standard"
              ],
              "title": "Bitrate Mode",
              "type": "string"
            },
            "duration": {
              "default": "auto",
              "description": "Duration of the video in seconds. Supports 4 to 30 seconds, or auto to let the model decide based on the prompt.",
