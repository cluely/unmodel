              "title": "Prompt",
              "type": "string"
            },
            "resolution": {
              "default": "720p",
              "description": "Video resolution - 480p for faster generation, 720p for balance, 1080p for high quality.",
              "enum": [
                "480p",
                "720p",
                "1080p"
