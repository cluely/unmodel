  "openapi": {
    "components": {
      "schemas": {
        "AuraSrInput": {
          "properties": {
            "checkpoint": {
              "default": "v1",
              "description": "Checkpoint to use for upscaling. More coming soon.",
              "enum": [
                "v1",
                "v2"
              ],
              "examples": [
                "v2",
                "v1"
              ],
              "title": "Checkpoint",
              "type": "string"
            },
            "image_url": {
              "description": "URL of the image to upscale.",
              "examples": [
                "https://storage.googleapis.com/falserverless/model_tests/svd/rocket.png",
                "https://storage.googleapis.com/falserverless/example_inputs/dog.png",
                "https://storage.googleapis.com/falserverless/example_inputs/girl.jpg"
              ],
              "title": "Image URL",
              "type": "string"
            },
            "overlapping_tiles": {
              "default": false,
              "description": "Whether to use overlapping tiles for upscaling. Setting this to true helps remove seams but doubles the inference time.",
              "examples": [
                true,
                false
              ],
              "title": "Overlapping Tiles",
              "type": "boolean"
            },
            "upscale_factor": {
              "const": 4,
              "default": 4,
              "description": "Upscaling factor. More coming soon.",
              "examples": [
                4
              ],
              "title": "Upscaling Factor (Xs)",
              "type": "integer"
            }
          },
          "required": [
            "image_url"
          ],
          "title": "Input",
          "type": "object",
          "x-fal-order-properties": [
            "image_url",
            "upscale_factor",
            "overlapping_tiles",
            "checkpoint"
          ]
        },
        "AuraSrOutput": {
          "properties": {
            "image": {
              "$ref": "#/components/schemas/Image",
              "description": "Upscaled image"
            },
            "timings": {
              "additionalProperties": {
                "type": "number"
              },
              "description": "Timings for each step in the pipeline.",
              "title": "Timings",
              "type": "object"
            }
          },
          "required": [
            "image",
            "timings"
          ],
          "title": "Output",
          "type": "object",
          "x-fal-order-properties": [
            "image",
            "timings"
          ]
        },
        "Image": {
          "description": "Represents an image file.",
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The height of the image in pixels.",
              "examples": [
                1024
              ],
              "title": "Height"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            },
            "width": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The width of the image in pixels.",
              "examples": [
                1024
              ],
              "title": "Width"
            }
          },
          "required": [
            "url"
          ],
          "title": "Image",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
        }
      }
    },
    "info": {
      "description": "The OpenAPI schema for the fal-ai/aura-sr queue.",
      "title": "Queue OpenAPI for fal-ai/aura-sr",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Run",
        "category": "image-to-image",
        "documentationUrl": "https://fal.ai/models/fal-ai/aura-sr/api",
