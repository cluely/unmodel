          "properties": {
            "end": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End time in seconds",
              "title": "End"
            },
            "speaker_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
