                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/elevenlabs/speech-to-text/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
