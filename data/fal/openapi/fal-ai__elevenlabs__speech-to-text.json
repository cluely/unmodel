      "x-fal-metadata": {
        "about": "ElevenLabs Speech to Text: Transcribe audio with high accuracy.\n\nTransforms spoken audio into text with word-level timestamps and\noptional speaker identification. Supports 99 languages with state-of-the-art accuracy.",
        "category": "speech-to-text",
        "documentationUrl": "https://fal.ai/models/fal-ai/elevenlabs/speech-to-text/api",
        "endpointId": "fal-ai/elevenlabs/speech-to-text",
