  "openapi": {
    "components": {
      "schemas": {
        "ElevenlabsSpeechToTextInput": {
          "properties": {
            "audio_url": {
              "description": "URL of the audio file to transcribe",
              "examples": [
                "https://v3.fal.media/files/zebra/zJL_oRY8h5RWwjoK1w7tx_output.mp3"
              ],
              "title": "Audio Url",
              "type": "string"
            },
            "diarize": {
              "default": true,
              "description": "Whether to annotate who is speaking",
              "title": "Diarize",
              "type": "boolean"
            },
            "language_code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Language code of the audio",
              "examples": [
                "eng",
                "spa",
                "fra",
                "deu",
                "jpn"
              ],
              "title": "Language Code"
            },
            "tag_audio_events": {
              "default": true,
              "description": "Tag audio events like laughter, applause, etc.",
              "title": "Tag Audio Events",
              "type": "boolean"
            }
          },
          "required": [
            "audio_url"
          ],
          "title": "SpeechToTextRequest",
          "type": "object",
          "x-fal-order-properties": [
            "audio_url",
            "language_code",
            "tag_audio_events",
            "diarize"
          ]
        },
        "ElevenlabsSpeechToTextOutput": {
          "properties": {
            "language_code": {
              "description": "Detected or specified language code",
              "title": "Language Code",
              "type": "string"
            },
            "language_probability": {
              "description": "Confidence in language detection",
              "title": "Language Probability",
              "type": "number"
            },
            "text": {
              "description": "The full transcribed text",
              "title": "Text",
              "type": "string"
            },
            "words": {
              "description": "Word-level transcription details",
              "items": {
                "$ref": "#/components/schemas/TranscriptionWord"
              },
              "title": "Words",
              "type": "array"
            }
          },
          "required": [
            "text",
            "language_code",
            "language_probability",
            "words"
          ],
          "title": "TranscriptionOutput",
          "type": "object",
          "x-fal-order-properties": [
            "text",
            "language_code",
            "language_probability",
            "words"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
