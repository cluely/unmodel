        "ControlNetUnionInput": {
          "properties": {
            "conditioning_scale": {
              "default": 1,
              "description": "\n            The scale of the control net weight. This is used to scale the control net weight\n            before merging it with the base model.\n        ",
              "maximum": 2,
              "minimum": 0,
              "title": "Conditioning Scale",
              "type": "number"
            },
            "control_image_url": {
              "description": "URL of the image to be used as the control image.",
              "title": "Control Image Url",
              "type": "string"
            },
            "control_mode": {
              "description": "Control Mode for Flux Controlnet Union. Supported values are:\n        - canny: Uses the edges for guided generation.\n        - tile: Uses the tiles for guided generation.\n        - depth: Utilizes a grayscale depth map for guided generation.\n        - blur: Adds a blur to the image.\n        - pose: Uses the pose of the image for guided generation.\n        - gray: Converts the image to grayscale.\n        - low-quality: Converts the image to a low-quality image.",
              "enum": [
                "canny",
                "tile",
                "depth",
                "blur",
                "pose",
                "gray",
                "low-quality"
              ],
              "title": "Control Mode",
              "type": "string"
            },
            "end_percentage": {
              "default": 1,
              "description": "\n            The percentage of the image to end applying the controlnet in terms of the total timesteps.\n        ",
              "maximum": 1,
              "minimum": 0,
              "title": "End Percentage",
              "type": "number"
            },
            "mask_image_url": {
              "description": "URL of the mask for the control image.",
              "title": "Mask Image Url",
              "type": "string"
            },
            "mask_threshold": {
              "default": 0.5,
              "description": "Threshold for mask.",
              "maximum": 0.99,
              "minimum": 0.01,
              "title": "Mask Threshold",
              "type": "number"
            },
            "start_percentage": {
              "default": 0,
              "description": "\n            The percentage of the image to start applying the controlnet in terms of the total timesteps.\n        ",
              "maximum": 1,
              "minimum": 0,
              "title": "Start Percentage",
              "type": "number"
            }
          },
          "required": [
            "control_image_url",
            "control_mode"
          ],
          "title": "ControlNetUnionInput",
          "type": "object",
          "x-fal-order-properties": [
            "control_image_url",
            "mask_image_url",
            "control_mode",
            "conditioning_scale",
            "mask_threshold",
            "start_percentage",
            "end_percentage"
          ]
        },
        "EasyControlWeight": {
          "properties": {
            "control_method_url": {
              "description": "URL to safetensor weights of control method to be applied. Can also be one of `canny`, `depth`, `hedsketch`, `inpainting`, `pose`, `seg`, `subject`, `ghibli` ",
              "examples": [
                "canny",
                "depth",
                "hedsketch",
                "inpainting",
