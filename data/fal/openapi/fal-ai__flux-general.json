                "seg",
                "subject",
                "ghibli"
              ],
              "title": "Control Method Url",
              "type": "string"
            },
            "image_control_type": {
              "description": "Control type of the image. Must be one of `spatial` or `subject`.",
              "enum": [
                "subject",
                "spatial"
              ],
              "title": "Image Control Type",
              "type": "string"
