        "ControlLoraWeight": {
          "properties": {
            "control_image_url": {
              "description": "URL of the image to be used as the control image.",
              "title": "Control Image Url",
              "type": "string"
            },
            "path": {
              "description": "URL or the path to the LoRA weights.",
              "title": "Path",
              "type": "string"
            },
            "preprocess": {
              "default": "None",
              "description": "Type of preprocessing to apply to the input image.",
