  "openapi": {
    "components": {
      "schemas": {
        "FluxProKontextInput": {
          "properties": {
            "aspect_ratio": {
              "anyOf": [
                {
                  "enum": [
                    "21:9",
                    "16:9",
                    "4:3",
                    "3:2",
                    "1:1",
                    "2:3",
                    "3:4",
                    "9:16",
                    "9:21"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The aspect ratio of the generated image.",
              "title": "Aspect Ratio"
            },
            "enhance_prompt": {
              "default": false,
              "description": "Whether to enhance the prompt for better results.",
              "title": "Enhance Prompt",
              "type": "boolean"
            },
            "guidance_scale": {
              "default": 3.5,
              "description": "\n            The CFG (Classifier Free Guidance) scale is a measure of how close you want\n            the model to stick to your prompt when looking for a related image to show you.\n        ",
              "maximum": 20,
              "minimum": 1,
              "title": "Guidance scale (CFG)",
              "type": "number"
            },
            "image_url": {
              "description": "Image prompt for the omni model.",
              "examples": [
                "https://v3.fal.media/files/rabbit/rmgBxhwGYb2d3pl3x9sKf_output.png"
              ],
              "minLength": 1,
              "title": "Image URL",
              "type": "string"
            },
            "num_images": {
              "default": 1,
              "description": "The number of images to generate.",
              "maximum": 4,
              "minimum": 1,
              "title": "Num Images",
              "type": "integer"
            },
            "output_format": {
              "default": "jpeg",
              "description": "The format of the generated image.",
              "enum": [
                "jpeg",
                "png"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "prompt": {
              "description": "The prompt to generate an image from.",
              "examples": [
                "Put a donut next to the flour."
              ],
              "title": "Prompt",
              "type": "string"
            },
            "safety_tolerance": {
              "default": "2",
              "description": "The safety tolerance level for the generated image. 1 being the most strict and 5 being the most permissive.",
              "enum": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6"
              ],
              "title": "Safety Tolerance",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "\n            The same seed and the same prompt given to the same version of the model\n            will output the same image every time.\n        ",
              "title": "Seed"
            },
            "sync_mode": {
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "title": "Sync Mode",
              "type": "boolean"
            }
          },
          "required": [
            "prompt",
            "image_url"
          ],
          "title": "FluxKontextInput",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "seed",
            "guidance_scale",
            "sync_mode",
            "num_images",
            "output_format",
            "safety_tolerance",
            "enhance_prompt",
            "aspect_ratio",
            "image_url"
          ]
        },
        "FluxProKontextOutput": {
          "properties": {
            "has_nsfw_concepts": {
              "description": "Whether the generated images contain NSFW concepts.",
              "items": {
                "type": "boolean"
              },
              "title": "Has Nsfw Concepts",
              "type": "array"
            },
            "images": {
              "description": "The generated image files info.",
              "examples": [
                [
                  {
                    "height": 1024,
                    "url": "https://fal.media/files/tiger/7dSJbIU_Ni-0Zp9eaLsvR_fe56916811d84ac69c6ffc0d32dca151.jpg",
                    "width": 1024
                  }
