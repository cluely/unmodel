      "x-fal-metadata": {
        "about": "FLUX.1 Kontext [pro] -- Frontier image editing model.\n\nKontext makes editing images easy! Specify what you want to change and Kontext will follow. It is capable of\nunderstanding the context of the image, making it easier to edit them without having to describe in details what\nyou want to do.",
        "category": "image-to-image",
        "documentationUrl": "https://fal.ai/models/fal-ai/flux-pro/kontext/api",
        "endpointId": "fal-ai/flux-pro/kontext",
        "playgroundUrl": "https://fal.ai/models/fal-ai/flux-pro/kontext",
        "thumbnailUrl": "https://storage.googleapis.com/fal_cdn/fal/Training-2.jpg"
      }
    },
    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/flux-pro/kontext": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FluxProKontextInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/flux-pro/kontext/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/FluxProKontextOutput"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/flux-pro/kontext/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/flux-pro/kontext/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
