                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/flux/dev/image-to-image/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
