{
  "metadata": {
    "category": "image-to-image",
    "date": "2024-07-11T00:00:00.000Z",
    "description": "FLUX.1 Image-to-Image is a high-performance endpoint for the FLUX.1 [dev] model that enables rapid transformation of existing images, delivering high-quality style transfers and image modifications with the core FLUX capabilities.",
    "display_name": "FLUX.1 [dev]",
    "group": {
      "key": "flux-1",
      "label": "Image to Image [dev]"
    },
    "highlighted": false,
    "is_favorited": null,
    "kind": "inference",
    "license_type": "commercial",
    "model_url": "https://fal.run/fal-ai/flux/dev/image-to-image",
    "pinned": false,
    "status": "active",
    "tags": [
      "style transfer"
    ],
    "thumbnail_url": "https://v3b.fal.media/files/b/0a9f91a9/up8aXYeFDjcRbQZDxV7vK_Jo37PJhg.png",
    "updated_at": "2026-06-24T10:32:41.401Z"
  },
  "openapi": {
    "components": {
      "schemas": {
        "FluxDevImageToImageInput": {
          "properties": {
            "acceleration": {
              "default": "none",
              "description": "The speed of the generation. The higher the speed, the faster the generation.",
              "enum": [
                "none",
                "regular",
                "high"
              ],
              "title": "Acceleration",
              "type": "string"
            },
            "enable_safety_checker": {
              "default": true,
              "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
              "title": "Enable Safety Checker",
              "type": "boolean"
            },
            "guidance_scale": {
              "default": 3.5,
              "description": "\n        The CFG (Classifier Free Guidance) scale is a measure of how close you want\n        the model to stick to your prompt when looking for a related image to show you.\n    ",
              "maximum": 20,
              "minimum": 1,
              "title": "Guidance scale (CFG)",
              "type": "number"
            },
            "image_url": {
              "description": "The URL of the image to generate an image from.",
              "examples": [
                "https://fal.media/files/koala/Chls9L2ZnvuipUTEwlnJC.png"
              ],
              "title": "Image URL",
              "type": "string"
            },
            "num_images": {
              "default": 1,
              "description": "The number of images to generate.",
              "maximum": 4,
              "minimum": 1,
              "title": "Num Images",
              "type": "integer"
            },
            "num_inference_steps": {
              "default": 40,
              "description": "The number of inference steps to perform.",
              "maximum": 50,
              "minimum": 10,
              "title": "Num Inference Steps",
              "type": "integer"
            },
            "output_format": {
              "default": "jpeg",
              "description": "The format of the generated image.",
              "enum": [
                "jpeg",
                "png"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "prompt": {
              "description": "The prompt to generate an image from.",
              "examples": [
                "A cat dressed as a wizard with a background of a mystic forest."
              ],
              "title": "Prompt",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "\n        The same seed and the same prompt given to the same version of the model\n        will output the same image every time.\n    ",
              "title": "Seed"
            },
            "strength": {
              "default": 0.95,
              "description": "The strength of the initial image. Higher strength values are better for this model.",
              "maximum": 1,
              "minimum": 0.01,
              "title": "Strength",
              "type": "number"
            },
            "sync_mode": {
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "title": "Sync Mode",
              "type": "boolean"
            }
          },
          "required": [
            "image_url",
            "prompt"
          ],
          "title": "BaseImageToInput",
          "type": "object",
          "x-fal-order-properties": [
            "image_url",
            "strength",
            "num_inference_steps",
            "prompt",
            "seed",
            "guidance_scale",
            "sync_mode",
            "num_images",
            "enable_safety_checker",
            "output_format",
            "acceleration"
          ]
        },
        "FluxDevImageToImageOutput": {
          "properties": {
            "has_nsfw_concepts": {
              "description": "Whether the generated images contain NSFW concepts.",
              "items": {
                "type": "boolean"
              },
              "title": "Has Nsfw Concepts",
              "type": "array"
            },
            "images": {
              "description": "The generated image files info.",
              "items": {
                "$ref": "#/components/schemas/Image"
              },
              "title": "Images",
              "type": "array"
            },
            "prompt": {
              "description": "The prompt used for generating the image.",
              "title": "Prompt",
              "type": "string"
            },
            "seed": {
              "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
              "title": "Seed",
              "type": "integer"
            },
            "timings": {
              "additionalProperties": {
                "type": "number"
              },
              "title": "Timings",
              "type": "object"
            }
          },
          "required": [
            "images",
            "timings",
            "seed",
            "has_nsfw_concepts",
            "prompt"
          ],
          "title": "Output",
          "type": "object",
          "x-fal-order-properties": [
            "images",
            "timings",
            "seed",
            "has_nsfw_concepts",
            "prompt"
          ]
        },
        "Image": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "image/jpeg",
              "title": "Content Type"
            },
            "height": {
              "title": "Height",
              "type": "integer"
            },
            "url": {
              "title": "Url",
              "type": "string"
            },
            "width": {
              "title": "Width",
              "type": "integer"
            }
          },
          "required": [
            "url",
            "width",
            "height"
          ],
          "title": "Image",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "width",
            "height",
            "content_type"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
        }
      }
    },
