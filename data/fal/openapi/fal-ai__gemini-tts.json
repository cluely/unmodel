        "GeminiTtsInput": {
          "description": "Input for Gemini text-to-speech generation.",
          "properties": {
            "language_code": {
              "anyOf": [
                {
                  "enum": [
                    "Arabic (Egypt)",
                    "Bangla (Bangladesh)",
                    "Dutch (Netherlands)",
                    "English (India)",
                    "English (US)",
                    "French (France)",
                    "German (Germany)",
                    "Hindi (India)",
