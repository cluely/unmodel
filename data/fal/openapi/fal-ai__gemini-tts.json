    "info": {
      "description": "The OpenAPI schema for the fal-ai/gemini-tts queue.",
      "title": "Queue OpenAPI for fal-ai/gemini-tts",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Generate speech from text using Google's Gemini TTS models.\n\nSupports 30 distinct voice presets and natural-language prompting\nfor fine-grained control over style, pace, accent, and emotion.",
        "category": "text-to-audio",
        "documentationUrl": "https://fal.ai/models/fal-ai/gemini-tts/api",
        "endpointId": "fal-ai/gemini-tts",
        "playgroundUrl": "https://fal.ai/models/fal-ai/gemini-tts",
        "thumbnailUrl": "https://v3b.fal.media/files/b/0a92f535/ZqM4YG4tJYjTMInUjWqEg_ce8628b8677f4b4dba1fd041fc169dac.png"
      }
    },
    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/gemini-tts": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeminiTtsInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/gemini-tts/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GeminiTtsOutput"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/gemini-tts/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/gemini-tts/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      }
    },
    "security": [
      {
