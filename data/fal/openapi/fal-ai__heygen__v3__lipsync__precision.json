        "HeygenV3LipsyncPrecisionInput": {
          "description": "Base request for lip-syncing a video (mode is determined by the endpoint).",
          "properties": {
            "audio_url": {
              "description": "URL of the replacement audio file.",
              "examples": [
                "https://v3b.fal.media/files/b/example/new_audio.mp3"
              ],
              "title": "Audio Url",
              "type": "string"
            },
            "disable_music_track": {
              "default": false,
              "description": "Remove background music from the source video.",
              "title": "Disable Music Track",
              "type": "boolean"
            },
            "enable_caption": {
              "default": false,
              "description": "Generate captions in the output video.",
              "title": "Enable Caption",
              "type": "boolean"
            },
            "enable_dynamic_duration": {
              "default": true,
              "description": "Allow duration adjustment to match the new audio.",
              "title": "Enable Dynamic Duration",
              "type": "boolean"
            },
            "enable_speech_enhancement": {
              "default": false,
              "description": "Enhance the replacement audio quality.",
              "title": "Enable Speech Enhancement",
              "type": "boolean"
            },
            "end_time": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End time in seconds for partial lipsync.",
              "title": "End Time"
            },
            "start_time": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start time in seconds for partial lipsync.",
              "title": "Start Time"
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional title for the lipsync job.",
              "title": "Title"
            },
            "video_url": {
              "description": "URL of the source video to lip-sync.",
              "examples": [
                "https://v3b.fal.media/files/b/0a9004c7/FM7Q5tK2b59x66Bl8HC0Z_vt-lang-en.mp4"
              ],
              "title": "Video Url",
              "type": "string"
            }
          },
          "required": [
            "video_url",
            "audio_url"
          ],
          "title": "V3LipsyncBaseRequest",
          "type": "object",
          "x-fal-order-properties": [
