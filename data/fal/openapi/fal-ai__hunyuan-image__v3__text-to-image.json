  "openapi": {
    "components": {
      "schemas": {
        "HunyuanImageV3TextToImageInput": {
          "properties": {
            "enable_prompt_expansion": {
              "default": false,
              "description": "Whether to enable prompt expansion. This will use a large language model to expand the prompt with additional details while maintaining the original meaning.",
              "examples": [
                true
              ],
              "title": "Enable Prompt Expansion",
              "type": "boolean"
            },
            "enable_safety_checker": {
              "default": true,
              "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
              "title": "Enable Safety Checker",
              "type": "boolean"
            },
            "guidance_scale": {
              "default": 7.5,
              "description": "Controls how much the model adheres to the prompt. Higher values mean stricter adherence.",
              "maximum": 20,
              "minimum": 1,
              "title": "Guidance Scale",
              "type": "number"
            },
            "image_size": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ImageSize"
                },
                {
                  "enum": [
                    "square_hd",
                    "square",
                    "portrait_4_3",
                    "portrait_16_9",
                    "landscape_4_3",
                    "landscape_16_9"
                  ],
                  "type": "string"
                }
              ],
              "default": "square_hd",
              "description": "The desired size of the generated image.",
              "title": "Image Size"
            },
            "negative_prompt": {
              "default": "",
              "description": "The negative prompt to guide the image generation away from certain concepts.",
              "examples": [
                "blurry, low quality, watermark, signature"
              ],
              "title": "Negative Prompt",
              "type": "string"
            },
            "num_images": {
              "default": 1,
              "description": "The number of images to generate.",
              "maximum": 4,
              "minimum": 1,
              "title": "Num Images",
              "type": "integer"
            },
            "num_inference_steps": {
              "default": 28,
              "description": "Number of denoising steps.",
              "maximum": 50,
              "minimum": 1,
              "title": "Num Inference Steps",
              "type": "integer"
            },
            "output_format": {
              "default": "png",
              "description": "The format of the generated image.",
              "enum": [
                "jpeg",
                "png"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "prompt": {
              "description": "The text prompt for image-to-image.",
              "examples": [
                "200mm telephoto through crowd gaps; subject laughing, candid; creamy background compression, color pop from a single bold garment, catchlight in eyes."
              ],
              "title": "Prompt",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Random seed for reproducible results. If None, a random seed is used.",
              "title": "Seed"
            },
            "sync_mode": {
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "title": "Sync Mode",
              "type": "boolean"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "HunyuanTextToImageInputV3",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "negative_prompt",
            "image_size",
            "num_images",
            "num_inference_steps",
            "guidance_scale",
            "seed",
            "enable_safety_checker",
            "sync_mode",
            "output_format",
            "enable_prompt_expansion"
          ]
        },
        "HunyuanImageV3TextToImageOutput": {
          "properties": {
            "images": {
              "description": "A list of the generated images.",
              "examples": [
                [
                  {
                    "content_type": "image/png",
                    "url": "https://v3b.fal.media/files/b/kangaroo/uIKrZHT6LaGqgXoxtBSn7.png"
                  }
                ]
              ],
              "items": {
                "$ref": "#/components/schemas/Image"
              },
              "title": "Images",
              "type": "array"
            },
            "seed": {
              "description": "The base seed used for the generation process.",
              "title": "Seed",
              "type": "integer"
            }
          },
          "required": [
            "images",
            "seed"
          ],
          "title": "HunyuanTextToImageV3Output",
          "type": "object",
          "x-fal-order-properties": [
            "images",
            "seed"
          ]
        },
        "Image": {
          "description": "Represents an image file.",
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The height of the image in pixels.",
              "examples": [
                1024
              ],
              "title": "Height"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            },
            "width": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The width of the image in pixels.",
              "examples": [
                1024
              ],
              "title": "Width"
            }
          },
          "required": [
            "url"
          ],
          "title": "Image",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ]
        },
        "ImageSize": {
          "properties": {
            "height": {
              "default": 512,
              "description": "The height of the generated image.",
              "exclusiveMinimum": 0,
              "maximum": 14142,
              "title": "Height",
              "type": "integer"
            },
            "width": {
              "default": 512,
              "description": "The width of the generated image.",
              "exclusiveMinimum": 0,
              "maximum": 14142,
              "title": "Width",
              "type": "integer"
            }
          },
          "title": "ImageSize",
          "type": "object",
          "x-fal-order-properties": [
            "width",
            "height"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
