          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "Hyper3dRodinV25TextTo3dInput": {
          "properties": {
            "TAPose": {
              "default": false,
              "description": "Generate characters in T-pose or A-pose format, making them easier to rig and animate in 3D software.",
              "title": "T/A Pose",
              "type": "boolean"
            },
            "addons": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RodinGen25Addons"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional add-ons"
            },
            "bbox_condition": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RodinGen25BbboxField"
                },
                {
                  "type": "null"
                }
              ],
              "description": "This is a controlnet that controls the maximum sized of the generated model."
            },
            "enable_creative_mode": {
              "default": false,
              "description": "If enabled, the generation will have enhanced generative robustness while ensuring output consistency. This corresponds to `geometry_instruct_mode` being equal to `creative` on the Hyper3D API.",
              "title": "Enable Creative Mode",
              "type": "boolean"
            },
            "geometry_file_format": {
              "default": "glb",
              "description": "Format of the geometry file. Possible values: glb, usdz, fbx, obj, stl. Default is glb.",
              "enum": [
                "glb",
                "usdz",
                "fbx",
                "obj",
                "stl"
              ],
              "title": "Geometry File Format",
              "type": "string"
            },
            "hd_texture": {
              "default": false,
              "description": "Enables enhanced texture post-processing for higher visual fidelity.",
              "title": "Hd Texture",
              "type": "boolean"
            },
            "is_micro": {
              "default": false,
              "description": "Generate finer micro-scale geometric detail. Only effective with `tier=\"Gen-2.5-Extreme-High\"`.",
              "title": "Is Micro",
              "type": "boolean"
            },
            "material": {
              "default": "All",
              "description": "Material type. PBR: physically-based materials with realistic lighting. Shaded: baked lighting with no PBR maps. All: both PBR and Shaded variants. None: geometry only with no textures.",
              "enum": [
                "PBR",
                "Shaded",
                "All",
                "None"
              ],
              "title": "Material",
              "type": "string"
            },
            "prompt": {
              "description": "A textual prompt to guide model generation. Required for Text-to-3D mode.",
              "examples": [
                "A futuristic robot with sleek metallic design."
              ],
              "maxLength": 1024,
              "title": "Prompt",
              "type": "string"
            },
            "quality_mesh_option": {
              "default": "Auto",
              "description": "Combined quality and mesh type selection. Quad = smooth surfaces, Triangle = detailed geometry. Maps to `mesh_mode` (Quad/Raw) and `quality_override` (face count) on the Hyper3D API. Valid face counts depend on the selected tier. Up to 1M Triangle is supported for tiers Extreme-Low, Low, and Medium. Up to 2M Triangle (as low as 20K Triangle) is supported for tiers High and Extreme-High. Auto option will choose the advised options for each tier:\n1. Gen-2.5-Minimum: 50K Triangle\n2. Gen-2.5-Extreme-Low: 50K Triangle\n3. Gen-2.5-Low: 50K Triangle\n4. Gen-2.5-Medium: 500K Triangle\n5. Gen-2.5-High: 500K Triangle\nGen-2.5-Extreme-High: 1M Triangle.",
              "enum": [
                "Auto",
                "4K Quad",
                "8K Quad",
                "18K Quad",
                "50K Quad",
                "100K Quad",
                "200K Quad",
                "2K Triangle",
                "20K Triangle",
                "50K Triangle",
                "150K Triangle",
                "500K Triangle",
                "1M Triangle",
                "2M Triangle"
              ],
              "title": "Quality Mesh Option",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Seed value for randomization, ranging from 0 to 65535. Optional.",
              "title": "Seed"
            },
            "texture_delight": {
              "default": false,
              "description": "Removes baked lighting/highlights from the generated textures.",
              "title": "Texture Delight",
              "type": "boolean"
            },
            "texture_mode": {
              "anyOf": [
                {
                  "enum": [
                    "legacy",
                    "extreme-low",
                    "low",
                    "medium",
                    "high"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Texture generation quality. When unset, the API picks a default appropriate for the tier.",
              "title": "Texture Mode"
            },
            "tier": {
              "default": "Gen-2.5-High",
              "description": "Generation tier. Higher tiers produce more detailed meshes but cost more. Extreme-High enables the highest-detail mode and bills at double the base rate. See more info in the [documentation](https://developer.hyper3d.ai/api-specification/rodin-gen2.5#use-gen-2.5-generation-with-following-gen-2.5-tiers). Selecting Gen-2.5-Minimum will automatically configure to a minimum mode, where 50K Triangle is selected, taking priority over quality_mesh_option.",
              "enum": [
                "Gen-2.5-Minimum",
                "Gen-2.5-Extreme-Low",
                "Gen-2.5-Low",
                "Gen-2.5-Medium",
                "Gen-2.5-High",
                "Gen-2.5-Extreme-High"
              ],
              "title": "Tier",
              "type": "string"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "RodinGen25TextTo3DInput",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "tier",
            "seed",
            "geometry_file_format",
            "material",
            "quality_mesh_option",
            "texture_mode",
            "enable_creative_mode",
            "hd_texture",
            "texture_delight",
            "is_micro",
            "TAPose",
            "bbox_condition",
            "addons"
          ]
        },
        "Hyper3dRodinV25TextTo3dOutput": {
          "properties": {
            "model_mesh": {
              "$ref": "#/components/schemas/File",
              "description": "Generated 3D object file.",
              "examples": [
                {
                  "url": "https://storage.googleapis.com/falserverless/model_tests/video_models/base_basic_shaded.glb"
                }
              ]
            },
            "model_meshes": {
              "description": "Additional generated 3D object files returned by Hyper3D besides model_mesh.",
              "items": {
                "$ref": "#/components/schemas/File"
              },
              "title": "Model Meshes",
              "type": "array"
            },
            "seed": {
              "description": "Seed value used for generation.",
              "title": "Seed",
              "type": "integer"
            },
            "textures": {
              "description": "Generated textures for the 3D object.",
              "items": {
                "$ref": "#/components/schemas/Image"
              },
              "title": "Textures",
              "type": "array"
            }
          },
          "required": [
            "model_mesh",
            "seed",
            "textures"
          ],
          "title": "ObjectOutputv2",
          "type": "object",
          "x-fal-order-properties": [
            "model_mesh",
            "model_meshes",
            "seed",
            "textures"
          ]
        },
        "Image": {
          "description": "Represents an image file.",
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
