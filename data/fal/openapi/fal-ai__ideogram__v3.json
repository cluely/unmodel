                    "C4D_CARTOON",
                    "CHILDRENS_BOOK",
                    "COLLAGE",
                    "COLORING_BOOK_I",
                    "COLORING_BOOK_II",
                    "CUBISM",
                    "DARK_AURA",
                    "DOODLE",
                    "DOUBLE_EXPOSURE",
                    "DRAMATIC_CINEMA",
                    "EDITORIAL",
                    "EMOTIONAL_MINIMAL",
                    "ETHEREAL_PARTY",
                    "EXPIRED_FILM",
                    "FLAT_ART",
                    "FLAT_VECTOR",
                    "FOREST_REVERIE",
                    "GEO_MINIMALIST",
                    "GLASS_PRISM",
                    "GOLDEN_HOUR",
                    "GRAFFITI_I",
                    "GRAFFITI_II",
                    "HALFTONE_PRINT",
                    "HIGH_CONTRAST",
                    "HIPPIE_ERA",
                    "ICONIC",
                    "JAPANDI_FUSION",
                    "JAZZY",
                    "LONG_EXPOSURE",
                    "MAGAZINE_EDITORIAL",
                    "MINIMAL_ILLUSTRATION",
                    "MIXED_MEDIA",
                    "MONOCHROME",
                    "NIGHTLIFE",
                    "OIL_PAINTING",
                    "OLD_CARTOONS",
                    "PAINT_GESTURE",
                    "POP_ART",
                    "RETRO_ETCHING",
                    "RIVIERA_POP",
                    "SPOTLIGHT_80S",
                    "STYLIZED_RED",
                    "SURREAL_COLLAGE",
                    "TRAVEL_POSTER",
                    "VINTAGE_GEO",
                    "VINTAGE_POSTER",
                    "WATERCOLOR",
                    "WEIRD",
                    "WOODBLOCK_PRINT"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Style preset for generation. The chosen style preset will guide the generation.",
              "title": "Style Preset"
            },
            "sync_mode": {
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "title": "Sync Mode",
              "type": "boolean"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "BaseTextToImageInputV3",
          "type": "object",
          "x-fal-order-properties": [
