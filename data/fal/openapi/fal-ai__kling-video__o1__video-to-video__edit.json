  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "KlingVideoO1VideoToVideoEditInput": {
          "description": "Input for video editing or video-as-reference generation.",
          "properties": {
            "elements": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/components/schemas/OmniVideoElementInput"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Elements (characters/objects) to include. Reference in prompt as @Element1, @Element2, etc. Maximum 4 total (elements + reference images) when using video.",
              "examples": [
                [
                  {
                    "frontal_image_url": "https://v3b.fal.media/files/b/panda/MQp-ghIqshvMZROKh9lW3.png",
                    "reference_image_urls": [
                      "https://v3b.fal.media/files/b/kangaroo/YMpmQkYt9xugpOTQyZW0O.png",
                      "https://v3b.fal.media/files/b/zebra/d6ywajNyJ6bnpa_xBue-K.png"
                    ]
                  }
                ]
              ],
              "title": "Elements"
            },
            "image_urls": {
              "anyOf": [
                {
                  "items": {
                    "_fal_ui_field": "image",
                    "limit_description": "Max file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
                    "type": "string",
                    "ui": {
                      "field": "image"
                    },
                    "x-fal": {
                      "max_aspect_ratio": 2.5,
                      "max_file_size": 10485760,
                      "min_aspect_ratio": 0.4,
                      "min_height": 300,
                      "min_width": 300,
                      "timeout": 20
                    }
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Reference images for style/appearance. Reference in prompt as @Image1, @Image2, etc. Maximum 4 total (elements + reference images) when using video.",
              "examples": [
                [
                  "https://v3b.fal.media/files/b/lion/MKvhFko5_wYnfORYacNII_AgPt8v25Wt4oyKhjnhVK5.png"
                ]
              ],
              "title": "Image Urls"
            },
            "keep_audio": {
              "default": false,
              "description": "Whether to keep the original audio from the video.",
              "title": "Keep Audio",
              "type": "boolean"
            },
            "prompt": {
              "description": "Use @Element1, @Element2 to reference elements and @Image1, @Image2 to reference images in order.",
              "examples": [
                "Replace the character in the video with @Element1, maintaining the same movements and camera angles. Transform the landscape into @Image1"
              ],
              "maxLength": 2500,
              "title": "Prompt",
              "type": "string"
            },
            "video_url": {
              "description": "Reference video URL. Only .mp4/.mov formats supported, 3-10 seconds duration, 720-2160px resolution, max 200MB.\n\nMax file size: 200.0MB, Min width: 720px, Min height: 720px, Max width: 2160px, Max height: 2160px, Min duration: 3.0s, Max duration: 10.05s, Min FPS: 24.0, Max FPS: 60.0, Timeout: 30.0s",
              "examples": [
                "https://v3b.fal.media/files/b/rabbit/ku8_Wdpf-oTbGRq4lB5DU_output.mp4"
              ],
              "title": "Video Url",
              "type": "string",
              "x-fal": {
                "max_duration": 10.05,
                "max_file_size": 209715200,
                "max_fps": 60,
                "max_height": 2160,
                "max_width": 2160,
                "min_duration": 3,
                "min_fps": 24,
                "min_height": 720,
                "min_width": 720,
                "timeout": 30
              }
            }
          },
          "required": [
            "prompt",
            "video_url"
          ],
          "title": "OmniV2VEditInput",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "video_url",
            "keep_audio",
            "image_urls",
            "elements"
          ]
        },
        "KlingVideoO1VideoToVideoEditOutput": {
          "properties": {
            "video": {
              "$ref": "#/components/schemas/File",
              "description": "The generated video.",
              "examples": [
                {
                  "content_type": "video/mp4",
                  "file_name": "output.mp4",
                  "file_size": 7533071,
                  "url": "https://v3b.fal.media/files/b/0a86603b/YAlbB2535l07BTy1wpDeI_output.mp4"
                }
              ]
            }
          },
          "required": [
            "video"
          ],
          "title": "OmniV2VEditOutput",
          "type": "object",
          "x-fal-order-properties": [
            "video"
          ]
        },
        "OmniVideoElementInput": {
          "properties": {
            "frontal_image_url": {
              "description": "The frontal image of the element (main view).\n\nMax file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
              "title": "Frontal Image Url",
              "type": "string",
              "x-fal": {
                "max_aspect_ratio": 2.5,
                "max_file_size": 10485760,
                "min_aspect_ratio": 0.4,
                "min_height": 300,
                "min_width": 300,
                "timeout": 20
              }
            },
            "reference_image_urls": {
              "description": "Additional reference images from different angles. 1-3 images supported. At least one image is required.",
              "items": {
                "_fal_ui_field": "image",
                "limit_description": "Max file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
                "type": "string",
                "x-fal": {
                  "max_aspect_ratio": 2.5,
                  "max_file_size": 10485760,
                  "min_aspect_ratio": 0.4,
                  "min_height": 300,
                  "min_width": 300,
                  "timeout": 20
                }
              },
              "title": "Reference Image Urls",
              "type": "array"
            }
          },
          "required": [
            "frontal_image_url"
          ],
          "title": "OmniVideoElementInput",
          "type": "object",
          "x-fal-order-properties": [
            "frontal_image_url",
            "reference_image_urls"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
