  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "KlingV3ImageElementInput": {
          "properties": {
            "frontal_image_url": {
              "anyOf": [
                {
                  "limit_description": "Max file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
                  "type": "string",
                  "ui": {
                    "field": "image"
                  },
                  "x-fal": {
                    "max_aspect_ratio": 2.5,
                    "max_file_size": 10485760,
                    "min_aspect_ratio": 0.4,
                    "min_height": 300,
                    "min_width": 300,
                    "timeout": 20
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "The frontal image of the element (main view).",
              "title": "Frontal Image Url"
            },
            "reference_image_urls": {
              "anyOf": [
                {
                  "items": {
                    "_fal_ui_field": "image",
                    "limit_description": "Max file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
                    "type": "string",
                    "ui": {
                      "field": "image"
                    },
                    "x-fal": {
                      "max_aspect_ratio": 2.5,
                      "max_file_size": 10485760,
                      "min_aspect_ratio": 0.4,
                      "min_height": 300,
                      "min_width": 300,
                      "timeout": 20
                    }
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Additional reference images from different angles. 1-3 images supported. At least one image is required.",
              "title": "Reference Image Urls"
            }
          },
          "title": "KlingV3ImageElementInput",
          "type": "object",
          "x-fal-order-properties": [
            "frontal_image_url",
            "reference_image_urls"
          ]
        },
        "KlingVideoO3ProVideoToVideoEditInput": {
          "properties": {
            "elements": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/components/schemas/KlingV3ImageElementInput"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Elements (characters/objects) to include. Reference in prompt as @Element1, @Element2.",
              "examples": [
                [
                  {
                    "frontal_image_url": "https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/element1_front.png",
                    "reference_image_urls": [
                      "https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/element1_reference1.png"
                    ]
                  }
                ]
              ],
              "title": "Elements"
            },
            "image_urls": {
              "anyOf": [
                {
                  "items": {
                    "_fal_ui_field": "image",
                    "limit_description": "Max file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
                    "type": "string",
                    "ui": {
                      "field": "image"
                    },
                    "x-fal": {
                      "max_aspect_ratio": 2.5,
                      "max_file_size": 10485760,
                      "min_aspect_ratio": 0.4,
                      "min_height": 300,
                      "min_width": 300,
                      "timeout": 20
                    }
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Reference images for style/appearance. Reference in prompt as @Image1, @Image2, etc. Maximum 4 total (elements + reference images) when using video.",
              "examples": [
                [
                  "https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/image_url1.jpg"
                ]
              ],
              "title": "Image Urls"
            },
            "keep_audio": {
              "default": true,
              "description": "Whether to keep the original audio from the reference video. ",
              "title": "Keep Audio",
              "type": "boolean"
            },
            "prompt": {
              "description": "Text prompt for video generation. Reference video as @Video1.",
              "examples": [
                "Change environment to be fully snow as @Image1. Replace animal with @Element1"
              ],
              "maxLength": 2500,
              "title": "Prompt",
              "type": "string"
            },
            "shot_type": {
              "const": "customize",
              "default": "customize",
              "description": "The type of multi-shot video generation.",
              "title": "Shot Type",
              "type": "string"
            },
            "video_url": {
              "_fal_ui_field": "video",
              "description": "Reference video URL. Only .mp4/.mov formats, 3-15s duration, 720-3840px resolution, max 200MB.",
              "examples": [
                "https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/video_reference.mp4"
              ],
              "limit_description": "Max file size: 200.0MB, Min width: 720px, Min height: 720px, Max width: 3840px, Max height: 3840px, Min duration: 3.0s, Max duration: 15.05s, Min FPS: 24.0, Max FPS: 60.0, Timeout: 30.0s",
              "title": "Video Url",
              "type": "string",
              "x-fal": {
                "max_duration": 15.05,
                "max_file_size": 209715200,
                "max_fps": 60,
                "max_height": 3840,
                "max_width": 3840,
                "min_duration": 3,
                "min_fps": 24,
                "min_height": 720,
                "min_width": 720,
                "timeout": 30
              }
            }
          },
          "required": [
            "prompt",
            "video_url"
          ],
          "title": "O3ProEditVideoV2VInput",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "video_url",
            "image_urls",
            "keep_audio",
            "elements",
            "shot_type"
          ]
        },
        "KlingVideoO3ProVideoToVideoEditOutput": {
          "properties": {
            "video": {
              "$ref": "#/components/schemas/File",
              "description": "The generated video.",
              "examples": [
                {
                  "content_type": "video/mp4",
                  "file_name": "output.mp4",
                  "file_size": 4322769,
                  "url": "https://storage.googleapis.com/falserverless/example_outputs/kling-o3/pro-v2v-edit/output.mp4"
                }
              ]
            }
          },
          "required": [
            "video"
          ],
          "title": "O3ProEditV2VOutput",
          "type": "object",
          "x-fal-order-properties": [
            "video"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
