        "KlingVideoV26ProImageToVideoInput": {
          "properties": {
            "duration": {
              "default": "5",
              "description": "The duration of the generated video in seconds",
              "enum": [
                "5",
                "10"
              ],
              "title": "Duration",
              "type": "string"
