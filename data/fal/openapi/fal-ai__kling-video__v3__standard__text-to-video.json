            },
            "prompt": {
              "description": "The prompt for this shot.",
              "title": "Prompt",
              "type": "string"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "KlingV3MultiPromptElement",
          "type": "object",
          "x-fal-order-properties": [
