      "video-to-video"
    ],
    "thumbnail_url": "https://v3b.fal.media/files/b/0a875717/5px7bRzEoq58JtxruJDKL_dd06f08a34c6477cbac929a55b2825ad.jpg",
    "updated_at": "2026-04-21T17:50:47.930Z"
  },
  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "LightxRelightInput": {
          "description": "Relighting-only request (minimal schema).",
          "properties": {
            "prompt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional text prompt. If omitted, Light-X will auto-caption the video.",
              "title": "Prompt"
            },
            "ref_id": {
              "default": 0,
              "description": "Frame index to use as reference to relight the video with reference. Must be less than the number of generated frames (default 49).",
              "maximum": 48,
              "minimum": 0,
              "title": "Ref Id",
              "type": "integer"
            },
            "relight_parameters": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RelightParameters"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Relighting parameters (required for relight_condition_type='ic'). Not used for 'bg' (which expects a background image URL instead).",
              "examples": [
                {
                  "bg_source": "Right",
                  "cfg": 2,
                  "relight_prompt": "Sunlight",
                  "use_sky_mask": false
                }
              ]
            },
            "relit_cond_img_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "URL of conditioning image. Required for relight_condition_type='ref'/'hdr'. Also required for relight_condition_type='bg' (background image).",
              "examples": [
                "https://storage.googleapis.com/falserverless/example_inputs/lightx_image.png"
              ],
              "title": "Relit Cond Img Url"
            },
            "relit_cond_type": {
              "default": "ic",
              "description": "Relight condition type.",
              "enum": [
                "ic",
                "ref",
                "hdr",
                "bg"
              ],
              "title": "Relit Cond Type",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Random seed for reproducibility. If None, a random seed is chosen.",
              "title": "Seed"
            },
            "video_url": {
              "description": "URL of the input video.",
              "examples": [
                "https://storage.googleapis.com/falserverless/example_inputs/lightx_video.mp4"
              ],
              "title": "Video Url",
              "type": "string"
            }
          },
          "required": [
            "video_url"
          ],
          "title": "LightXRelightRequest",
          "type": "object",
          "x-fal-order-properties": [
            "video_url",
            "prompt",
            "seed",
            "relit_cond_type",
            "relight_parameters",
            "relit_cond_img_url",
            "ref_id"
          ]
        },
        "LightxRelightOutput": {
          "properties": {
            "input_video": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional: normalized/processed input video (if produced by the pipeline)."
            },
            "seed": {
              "description": "The seed used for generation.",
              "title": "Seed",
              "type": "integer"
            },
            "video": {
              "$ref": "#/components/schemas/File",
              "description": "The generated video file.",
              "examples": [
                "https://v3b.fal.media/files/b/0a8715c9/x378fHboeiGD6j_0nbWlJ_gen.mp4"
              ]
            },
            "viz_video": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional: visualization/debug video (if produced by the pipeline)."
            }
          },
          "required": [
            "video",
            "seed"
          ],
          "title": "LightXOutput",
          "type": "object",
          "x-fal-order-properties": [
            "video",
            "seed",
            "input_video",
            "viz_video"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
        "RelightParameters": {
          "description": "Relighting parameters for video relighting operations.\n\nUsed with relight_condition_type 'ic' (intrinsic conditioning).",
          "properties": {
            "bg_source": {
              "default": "Left",
              "description": "Direction of the light source (used for IC-light).",
              "enum": [
                "Left",
                "Right",
                "Top",
                "Bottom"
              ],
              "title": "Bg Source",
              "type": "string"
            },
            "cfg": {
              "default": 2,
              "description": "Classifier-free guidance scale for relighting.",
              "maximum": 10,
              "minimum": 1,
              "title": "Cfg",
              "type": "number"
            },
            "relight_prompt": {
              "description": "Text prompt describing the desired lighting condition.",
              "examples": [
                "Sunlight",
                "Red and Blue Neon Light",
                "Warm indoor lighting"
              ],
              "title": "Relight Prompt",
              "type": "string"
            },
            "use_sky_mask": {
              "default": false,
              "description": "Whether to use sky masking for outdoor scenes.",
              "title": "Use Sky Mask",
              "type": "boolean"
            }
          },
          "required": [
            "relight_prompt"
          ],
          "title": "RelightParameters",
          "type": "object",
          "x-fal-order-properties": [
            "relight_prompt",
            "bg_source",
            "cfg",
            "use_sky_mask"
          ]
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
        }
      }
    },
    "info": {
      "description": "The OpenAPI schema for the fal-ai/lightx/relight queue.",
      "title": "Queue OpenAPI for fal-ai/lightx/relight",
