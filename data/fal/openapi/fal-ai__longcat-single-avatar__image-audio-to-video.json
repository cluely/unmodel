  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "LongcatSingleAvatarImageAudioToVideoInput": {
          "description": "Request model for image+audio to video generation.",
          "properties": {
            "audio_guidance_scale": {
              "default": 4,
              "description": "The audio guidance scale. Higher values may lead to exaggerated mouth movements.",
              "maximum": 10,
              "minimum": 1,
              "title": "Audio Guidance Scale",
              "type": "number"
            },
            "audio_url": {
              "description": "The URL of the audio file to drive the avatar.",
              "examples": [
                "https://raw.githubusercontent.com/meituan-longcat/LongCat-Video/refs/heads/main/assets/avatar/single/man.mp3"
              ],
              "title": "Audio URL",
              "type": "string"
            },
            "enable_prompt_expansion": {
              "default": false,
              "description": "Whether to enable prompt expansion using an LLM to enhance the prompt for better video quality.",
              "title": "Enable Prompt Expansion",
              "type": "boolean"
            },
            "enable_safety_checker": {
              "default": true,
              "description": "Whether to enable safety checker. Disabling it requires account authorization; unauthorized requests are always checked.",
              "title": "Enable Safety Checker",
              "type": "boolean"
            },
            "image_url": {
              "description": "The URL of the image to animate.",
              "examples": [
                "https://raw.githubusercontent.com/meituan-longcat/LongCat-Video/refs/heads/main/assets/avatar/single/man.png"
              ],
              "title": "Image URL",
              "type": "string"
            },
            "negative_prompt": {
              "default": "Close-up, Bright tones, overexposed, static, blurred details, subtitles, style, works, paintings, images, static, overall gray, worst quality, low quality, JPEG compression residue, ugly, incomplete, extra fingers, poorly drawn hands, poorly drawn faces, deformed, disfigured, misshapen limbs, fused fingers, still picture, messy background, three legs, many people in the background, walking backwards",
              "description": "The negative prompt to avoid in the video generation.",
              "title": "Negative Prompt",
              "type": "string"
            },
            "num_inference_steps": {
              "default": 50,
              "description": "The number of inference steps to use.",
              "maximum": 100,
              "minimum": 10,
              "title": "Number of Inference Steps",
              "type": "integer"
            },
            "num_segments": {
              "default": 1,
              "description": "Number of video segments to generate. Each segment adds ~5 seconds of video. First segment is ~5.8s, additional segments are 5s each.",
              "maximum": 10,
              "minimum": 1,
              "title": "Number of Segments",
              "type": "integer"
            },
            "prompt": {
              "default": "A person is talking naturally with natural expressions and movements.",
              "description": "The prompt to guide the video generation.",
              "examples": [
                "A western man stands on stage under dramatic lighting, holding a microphone close to their mouth. Wearing a vibrant red jacket with gold embroidery, the singer is speaking while smoke swirls around them, creating a dynamic and atmospheric scene."
              ],
              "title": "Prompt",
              "type": "string"
            },
            "resolution": {
              "default": "480p",
              "description": "Resolution of the generated video (480p or 720p). Billing is per video-second (16 frames): 480p is 1 unit per second and 720p is 4 units per second.",
              "enum": [
                "480p",
                "720p"
              ],
              "title": "Resolution",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The seed for the random number generator.",
              "title": "Seed"
            },
            "text_guidance_scale": {
              "default": 4,
              "description": "The text guidance scale for classifier-free guidance.",
              "maximum": 10,
              "minimum": 1,
              "title": "Text Guidance Scale",
              "type": "number"
            }
          },
          "required": [
            "image_url",
            "audio_url"
          ],
          "title": "ImageAudioToVideoRequest",
          "type": "object",
          "x-fal-order-properties": [
            "image_url",
            "audio_url",
            "prompt",
            "negative_prompt",
            "num_inference_steps",
            "text_guidance_scale",
            "audio_guidance_scale",
            "resolution",
            "num_segments",
            "seed",
            "enable_safety_checker",
            "enable_prompt_expansion"
          ]
        },
        "LongcatSingleAvatarImageAudioToVideoOutput": {
          "description": "Response model for image+audio to video generation.",
          "properties": {
            "seed": {
              "description": "The seed used for generation.",
              "examples": [
                424911732
              ],
              "title": "Seed",
              "type": "integer"
            },
            "video": {
              "$ref": "#/components/schemas/File",
              "description": "The generated video file.",
              "examples": [
                "https://v3b.fal.media/files/b/0a87a0ce/2TnxxI02RHnLUvjGzhZa7_output_86da44aa6eed40ff9061b2213fb19793.mp4"
              ]
            }
          },
          "required": [
            "video",
            "seed"
          ],
          "title": "ImageAudioToVideoResponse",
          "type": "object",
          "x-fal-order-properties": [
            "video",
            "seed"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
