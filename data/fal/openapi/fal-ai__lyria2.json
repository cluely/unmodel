    "info": {
      "description": "The OpenAPI schema for the fal-ai/lyria2 queue.",
      "title": "Queue OpenAPI for fal-ai/lyria2",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Generate music using Google's Lyria 2 text-to-music model.\n\nFor best results, prompts should be descriptive and clear. Include:\n- Genre/Style: Specify the musical genre (e.g., \"classical\", \"electronic\", \"rock\", \"jazz\", \"hip hop\")\n- Mood/Emotion: Describe the desired feeling or atmosphere (e.g., \"happy\", \"melancholy\", \"energetic\")\n- Instrumentation: List the instruments you want to hear (e.g., \"piano\", \"synthesizer\", \"acoustic guitar\")\n- Tempo/Rhythm: Indicate the speed and feel (e.g., \"fast tempo\", \"slow ballad\", \"driving beat\")\n- Soundscapes/Effects: For non-musical audio, describe the environment or specific sound effects\n- Arrangement/Structure: Briefly describe the progression or layering of sounds if important\n- Production Quality: Terms like \"high-quality production,\" \"clean mix,\" or \"vintage recording\"\n\nThe model supports:\n- 48kHz WAV audio output\n- 30 second duration\n- Negative prompting to exclude unwanted elements\n- Seed-based reproducibility\n\nSafety filters prevent generation of inappropriate content.",
        "category": "text-to-audio",
        "documentationUrl": "https://fal.ai/models/fal-ai/lyria2/api",
        "endpointId": "fal-ai/lyria2",
        "playgroundUrl": "https://fal.ai/models/fal-ai/lyria2",
        "thumbnailUrl": "https://storage.googleapis.com/fal_cdn/fal/Sound-4.jpg"
      }
    },
    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/lyria2": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lyria2Input"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/lyria2/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Lyria2Output"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/lyria2/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/lyria2/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      }
    },
