              "title": "Is Instrumental",
              "type": "boolean"
            },
            "lyrics": {
              "default": "",
              "description": "Lyrics of the song. Use \\n to separate lines. Supports structure tags: [Intro], [Verse], [Pre Chorus], [Chorus], [Post Chorus], [Hook], [Bridge], [Interlude], [Transition], [Build Up], [Break], [Inst], [Solo], [Outro]. Max 3500 characters. Required when is_instrumental is false.",
              "examples": [
                "[verse]\nStreetlights flicker, the night breeze sighs\nShadows stretch as I walk alone\n[chorus]\nWandering, longing, where should I go"
              ],
              "maxLength": 3500,
              "title": "Lyrics",
              "type": "string"
            },
            "lyrics_optimizer": {
              "default": false,
              "description": "When true and lyrics is empty, auto-generates lyrics from the prompt.",
              "title": "Lyrics Optimizer",
              "type": "boolean"
            },
            "prompt": {
              "description": "A description of the music style, mood, genre, and scenario. 10-2000 characters.",
              "examples": [
                "City Pop, 80s retro, groovy synth bass, warm female vocal, 104 BPM, nostalgic urban night"
              ],
              "maxLength": 2000,
              "minLength": 10,
              "title": "Prompt",
              "type": "string"
            }
