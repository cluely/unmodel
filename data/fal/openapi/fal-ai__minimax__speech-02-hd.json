            "vol": {
              "default": 1,
              "description": "Volume (0-10)",
              "maximum": 10,
              "minimum": 0.01,
              "title": "Vol",
              "type": "number"
            }
          },
          "title": "VoiceSetting",
          "type": "object",
          "x-fal-order-properties": [
            "voice_id",
            "speed",
            "vol",
