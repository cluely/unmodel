                128000,
                256000
              ],
              "title": "Bitrate",
              "type": "integer"
            },
            "channel": {
              "default": 1,
              "description": "Number of audio channels (1=mono, 2=stereo)",
              "enum": [
                1,
                2
              ],
              "title": "Channel",
              "type": "integer"
            },
            "format": {
              "default": "mp3",
              "description": "Audio format",
              "enum": [
