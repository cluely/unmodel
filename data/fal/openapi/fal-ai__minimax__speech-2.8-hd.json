  "openapi": {
    "components": {
      "schemas": {
        "AudioSetting": {
          "properties": {
            "bitrate": {
              "default": 128000,
              "description": "Bitrate of generated audio",
              "enum": [
                32000,
                64000,
                128000,
                256000
              ],
              "title": "Bitrate",
              "type": "integer"
            },
            "channel": {
              "default": 1,
              "description": "Number of audio channels (1=mono, 2=stereo)",
              "enum": [
                1,
                2
              ],
              "title": "Channel",
              "type": "integer"
            },
            "format": {
              "default": "mp3",
              "description": "Audio format",
              "enum": [
                "mp3",
                "pcm",
                "flac"
              ],
              "title": "Format",
              "type": "string"
            },
            "sample_rate": {
              "default": 32000,
              "description": "Sample rate of generated audio",
              "enum": [
                8000,
                16000,
                22050,
                24000,
                32000,
                44100
              ],
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "AudioSetting",
          "type": "object",
          "x-fal-order-properties": [
            "sample_rate",
            "bitrate",
            "format",
            "channel"
          ]
        },
        "File": {
