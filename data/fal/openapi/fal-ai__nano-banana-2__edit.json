            "height"
          ]
        },
        "NanoBanana2EditInput": {
          "properties": {
            "aspect_ratio": {
              "anyOf": [
                {
                  "enum": [
                    "auto",
                    "21:9",
                    "16:9",
                    "3:2",
                    "4:3",
                    "5:4",
                    "1:1",
                    "4:5",
                    "3:4",
                    "2:3",
                    "9:16",
                    "4:1",
                    "1:4",
                    "8:1",
                    "1:8"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "auto",
              "description": "The aspect ratio of the generated image. Supports extreme ratios: 4:1, 1:4, 8:1, 1:8.",
              "title": "Aspect Ratio"
            },
            "audio_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional audio file to use as input context. Accepts an http(s)/data URL (downloaded and sent inline, max 15MB).",
              "examples": [
                "https://storage.googleapis.com/falserverless/example_inputs/reference_audio.wav"
              ],
              "title": "Audio URL"
            },
            "enable_web_search": {
              "default": false,
              "description": "Enable web search for the image generation task. This will allow the model to use the latest information from the web to generate the image.",
              "title": "Enable Web Search",
              "type": "boolean"
            },
            "image_urls": {
              "description": "The URLs of the images to use for image-to-image generation or image editing. Optional when at least one of `video_url`, `audio_url`, or `pdf_url` is provided.",
              "examples": [
                [
                  "https://storage.googleapis.com/falserverless/example_inputs/nano-banana-edit-input.png",
                  "https://storage.googleapis.com/falserverless/example_inputs/nano-banana-edit-input-2.png"
                ]
              ],
              "items": {
                "type": "string"
              },
              "title": "Image URLs",
              "type": "array"
            },
            "limit_generations": {
              "default": true,
              "description": "Experimental parameter to limit the number of generations from each round of prompting to 1. Set to `True` to to disregard any instructions in the prompt regarding the number of images to generate and ignore any intermediate images generated by the model. This may affect generation quality.",
              "title": "Limit Generations",
              "type": "boolean"
            },
            "num_images": {
              "default": 1,
              "description": "The number of images to generate.",
              "maximum": 4,
              "minimum": 1,
              "title": "Number of Images",
              "type": "integer"
            },
            "output_format": {
              "default": "png",
              "description": "The format of the generated image.",
              "enum": [
                "jpeg",
                "png",
                "webp"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "pdf_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional PDF document to use as input context. Accepts an http(s)/data URL (downloaded and sent inline, max 15MB).",
              "examples": [
                "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf"
              ],
              "title": "PDF URL"
            },
            "prompt": {
              "description": "The prompt for image editing.",
              "examples": [
                "make a photo of the man driving the car down the california coastline"
              ],
              "maxLength": 50000,
              "minLength": 3,
              "title": "Prompt",
              "type": "string"
            },
            "resolution": {
              "default": "1K",
              "description": "The resolution of the image to generate.",
              "enum": [
                "0.5K",
                "1K",
                "2K",
                "4K"
              ],
              "title": "Resolution",
              "type": "string"
            },
            "safety_tolerance": {
              "default": "4",
              "description": "The safety tolerance level for content moderation. 1 is the most strict (blocks most content), 6 is the least strict.",
              "enum": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6"
              ],
              "title": "Safety Tolerance",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The seed for the random number generator.",
              "title": "Seed"
            },
            "sync_mode": {
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "title": "Sync Mode",
              "type": "boolean"
            },
            "system_prompt": {
              "default": "",
              "description": "Optional system instruction that steers the model's persona and output style across the request. Leave blank to omit; when provided, it is sent as the system instruction to Gemini (or as a system message on OpenAI-compatible providers).",
              "maxLength": 50000,
              "title": "System Prompt",
              "type": "string"
            },
            "thinking_level": {
              "anyOf": [
                {
                  "enum": [
                    "minimal",
                    "high"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When set, enables model thinking with the given level ('minimal' or 'high') and includes thoughts in the generation. Omit to disable.",
              "title": "Thinking Level"
            },
            "video_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional video to use as input context. Accepts an http(s)/data URL to a video file (downloaded and sent inline, max 15MB) or a YouTube URL (passed through to the model without downloading).",
              "examples": [
                "https://storage.googleapis.com/falserverless/web-examples/wan/t2v.mp4"
              ],
              "title": "Video URL"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "NanoBanana2ImageToImageInput",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "num_images",
            "seed",
            "aspect_ratio",
            "output_format",
            "safety_tolerance",
            "sync_mode",
            "image_urls",
            "system_prompt",
            "resolution",
            "video_url",
            "audio_url",
            "pdf_url",
            "limit_generations",
            "enable_web_search",
            "thinking_level"
          ]
        },
        "NanoBanana2EditOutput": {
          "properties": {
            "description": {
              "description": "The description of the generated images.",
              "title": "Description",
              "type": "string"
            },
            "images": {
              "description": "The edited images.",
              "examples": [
                [
                  {
                    "content_type": "image/png",
                    "file_name": "nano-banana-2-edit-output.png",
                    "url": "https://storage.googleapis.com/falserverless/example_outputs/nano-banana-2-edit-output.png"
                  }
                ]
              ],
              "items": {
                "$ref": "#/components/schemas/ImageFile"
              },
              "title": "Images",
              "type": "array"
            }
          },
          "required": [
            "images",
            "description"
          ],
          "title": "NanoBanana2ImageToImageOutput",
          "type": "object",
          "x-fal-order-properties": [
            "images",
            "description"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
