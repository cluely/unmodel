            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
