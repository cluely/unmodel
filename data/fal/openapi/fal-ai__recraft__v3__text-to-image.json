    "paths": {
      "/fal-ai/recraft/v3/text-to-image": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecraftV3TextToImageInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/recraft/v3/text-to-image/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/RecraftV3TextToImageOutput"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/recraft/v3/text-to-image/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/recraft/v3/text-to-image/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      }
