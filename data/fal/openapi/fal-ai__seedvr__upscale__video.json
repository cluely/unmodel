        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
