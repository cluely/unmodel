              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
        "SeedvrUpscaleVideoInput": {
          "properties": {
            "noise_scale": {
              "default": 0.1,
              "description": "The noise scale to use for the generation process.",
              "maximum": 1,
              "minimum": 0,
              "multipleOf": 0.001,
              "title": "Noise Scale",
              "type": "number"
            },
            "output_format": {
              "default": "X264 (.mp4)",
              "description": "The format of the output video.",
              "enum": [
                "X264 (.mp4)",
                "VP9 (.webm)",
                "PRORES4444 (.mov)",
                "GIF (.gif)"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "output_quality": {
              "default": "high",
              "description": "The quality of the output video.",
              "enum": [
                "low",
                "medium",
                "high",
                "maximum"
              ],
              "title": "Output Quality",
              "type": "string"
            },
            "output_write_mode": {
              "default": "balanced",
              "description": "The write mode of the output video.",
              "enum": [
                "fast",
                "balanced",
                "small"
              ],
              "title": "Output Write Mode",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The random seed used for the generation process.",
              "title": "Seed"
            },
            "sync_mode": {
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "title": "Sync Mode",
              "type": "boolean"
            },
            "target_resolution": {
              "default": "1080p",
              "description": "The target resolution to upscale to when `upscale_mode` is `target`.",
              "enum": [
                "720p",
                "1080p",
                "1440p",
                "2160p"
              ],
              "title": "Target Resolution",
              "type": "string"
            },
            "upscale_factor": {
              "default": 2,
              "description": "Upscaling factor to be used. Will multiply the dimensions with this factor when `upscale_mode` is `factor`.",
              "maximum": 10,
              "minimum": 1,
              "title": "Upscale Factor",
              "type": "number"
            },
            "upscale_mode": {
              "default": "factor",
              "description": "The mode to use for the upscale. If 'target', the upscale factor will be calculated based on the target resolution. If 'factor', the upscale factor will be used directly.",
              "enum": [
                "target",
                "factor"
              ],
              "title": "Upscale Mode",
              "type": "string"
            },
            "video_url": {
              "description": "The input video to be processed",
              "examples": [
                "https://storage.googleapis.com/falserverless/example_inputs/seedvr-input.mp4"
              ],
              "title": "Video Url",
              "type": "string"
            }
          },
          "required": [
            "video_url"
          ],
          "title": "SeedVRVideoInput",
          "type": "object",
          "x-fal-order-properties": [
            "video_url",
            "upscale_mode",
            "upscale_factor",
            "target_resolution",
            "seed",
            "noise_scale",
            "output_format",
            "output_quality",
            "output_write_mode",
            "sync_mode"
          ]
        },
        "SeedvrUpscaleVideoOutput": {
          "properties": {
            "seed": {
              "description": "The random seed used for the generation process.",
              "title": "Seed",
              "type": "integer"
            },
            "video": {
              "$ref": "#/components/schemas/File",
              "description": "Upscaled video file after processing",
              "examples": [
                {
                  "content_type": "video/mp4",
                  "url": "https://storage.googleapis.com/falserverless/example_outputs/seedvr-output.mp4"
                }
              ]
            }
          },
          "required": [
            "video",
            "seed"
          ],
          "title": "SeedVRVideoOutput",
          "type": "object",
          "x-fal-order-properties": [
            "video",
            "seed"
          ]
        }
