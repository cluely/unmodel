        "Sync3ActiveSpeakerDetection": {
          "properties": {
            "auto_detect": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Whether to automatically detect and apply generation to the active speaker.",
              "title": "Auto Detect"
            },
            "bounding_boxes": {
              "anyOf": [
                {
                  "items": {
                    "anyOf": [
                      {
                        "items": {
                          "type": "integer"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Per-frame bounding boxes [x1, y1, x2, y2] for the detected face.",
              "title": "Bounding Boxes"
            },
            "bounding_boxes_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "URL to a JSON file containing per-frame bounding boxes.",
              "title": "Bounding Boxes Url"
            },
            "coordinates": {
              "anyOf": [
                {
                  "items": {
                    "type": "integer"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Reference point [x, y] on the speaker's face in frame_number.",
              "title": "Coordinates"
            },
            "face_image": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Base64 encoded face image for manual speaker selection.",
              "title": "Face Image"
            },
            "frame_number": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Frame index for manual speaker selection coordinates.",
              "title": "Frame Number"
            },
            "use_v2": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Deprecated Sync.so option for active speaker detection v2.",
              "title": "Use V2"
            },
            "v3": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Whether to use Sync.so's active speaker detection v3.",
              "title": "V3"
            }
          },
          "title": "Sync3ActiveSpeakerDetection",
          "type": "object",
          "x-fal-order-properties": [
            "auto_detect",
            "v3",
            "use_v2",
            "frame_number",
            "coordinates",
            "bounding_boxes",
            "bounding_boxes_url",
            "face_image"
          ]
        },
        "Sync3GenerationOptions": {
          "properties": {
            "active_speaker_detection": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Sync3ActiveSpeakerDetection"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Active speaker detection configuration for videos with multiple people."
            },
            "model_mode": {
              "anyOf": [
                {
                  "enum": [
                    "lips",
                    "face",
                    "head",
                    "lipsync",
                    "emotion",
                    "talking_head"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Edit region for the model. This is a Sync.so option primarily used by react-1.",
              "title": "Model Mode"
            },
            "occlusion_detection_enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Whether to detect occlusion during generation. Sync.so handles this automatically for sync-3, so this option is ignored by sync-3.",
              "title": "Occlusion Detection Enabled"
            },
            "prompt": {
              "anyOf": [
                {
                  "enum": [
                    "happy",
                    "sad",
                    "angry",
                    "disgusted",
                    "surprised",
                    "neutral"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Emotion prompt for generation. This is a Sync.so option primarily used by react-1.",
              "title": "Prompt"
            },
            "sync_mode": {
              "anyOf": [
                {
                  "enum": [
                    "cut_off",
                    "loop",
                    "bounce",
                    "silence",
                    "remap"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defines how to handle duration mismatches between video and audio inputs. Overrides the top-level sync_mode when provided.",
              "title": "Sync Mode"
            },
            "temperature": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Controls how expressive lipsync can be; 0 is least expressive, 1 is most expressive. Sync.so handles this natively for sync-3, so this option is ignored by sync-3.",
              "title": "Temperature"
            }
          },
          "title": "Sync3GenerationOptions",
          "type": "object",
          "x-fal-order-properties": [
            "sync_mode",
            "model_mode",
            "prompt",
            "temperature",
            "active_speaker_detection",
            "occlusion_detection_enabled"
          ]
        },
        "SyncLipsyncV3Input": {
          "properties": {
            "audio_url": {
              "description": "URL of the input audio",
              "examples": [
                "https://fal.media/files/lion/vyFWygmZsIZlUO4s0nr2n.wav"
              ],
              "title": "Audio Url",
              "type": "string"
            },
            "options": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Sync3GenerationOptions"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Additional Sync.so generation options. If options.sync_mode is set, it overrides the top-level sync_mode field."
            },
            "sync_mode": {
              "default": "cut_off",
              "description": "Lipsync mode when audio and video durations are out of sync.",
              "enum": [
                "cut_off",
                "loop",
                "bounce",
                "silence",
                "remap"
              ],
              "title": "Sync Mode",
              "type": "string"
            },
            "video_url": {
              "description": "URL of the input video",
              "examples": [
                "https://v3.fal.media/files/tiger/IugLCDJRIoGqvqTa-EJTr_3wg74vCqyNuQ-IiBd77MM_output.mp4"
              ],
              "title": "Video Url",
              "type": "string"
            }
          },
          "required": [
            "video_url",
            "audio_url"
          ],
          "title": "Sync3Input",
          "type": "object",
          "x-fal-order-properties": [
            "video_url",
            "audio_url",
            "sync_mode",
            "options"
          ]
        },
        "SyncLipsyncV3Output": {
          "properties": {
            "video": {
              "$ref": "#/components/schemas/File",
              "description": "The generated video",
              "examples": [
                {
                  "url": "https://v3b.fal.media/files/b/0a93c312/TqKMiLtCcTKWSeAWXJRD0_output.mp4"
                }
              ]
            }
          },
          "required": [
            "video"
          ],
          "title": "Sync3Output",
          "type": "object",
          "x-fal-order-properties": [
            "video"
          ]
        }
      },
