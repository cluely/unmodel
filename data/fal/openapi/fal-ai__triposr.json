            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
        "TriposrInput": {
          "properties": {
            "do_remove_background": {
              "default": true,
              "description": "Whether to remove the background from the input image.",
              "title": "Do Remove Background",
              "type": "boolean"
            },
            "foreground_ratio": {
              "default": 0.9,
              "description": "Ratio of the foreground image to the original image.",
              "maximum": 1,
              "minimum": 0.5,
              "title": "Foreground Ratio",
              "type": "number"
            },
            "image_url": {
              "description": "Path for the image file to be processed.",
