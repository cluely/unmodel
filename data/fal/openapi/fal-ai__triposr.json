        "TriposrOutput": {
          "properties": {
            "model_mesh": {
              "$ref": "#/components/schemas/File",
              "description": "Generated 3D object file."
            },
            "remeshing_dir": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Directory containing textures for the remeshed model."
            },
            "timings": {
              "additionalProperties": {
                "type": "number"
              },
              "description": "Inference timings.",
              "title": "Timings",
              "type": "object"
            }
          },
          "required": [
            "model_mesh",
            "timings"
          ],
          "title": "ObjectOutput",
          "type": "object",
          "x-fal-order-properties": [
            "model_mesh",
            "timings",
            "remeshing_dir"
          ]
        }
