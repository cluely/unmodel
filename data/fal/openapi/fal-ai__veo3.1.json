    "info": {
      "description": "The OpenAPI schema for the fal-ai/veo3.1 queue.",
      "title": "Queue OpenAPI for fal-ai/veo3.1",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Generate videos using Google's Veo 3.1 model.\n\nFor best results, prompts should be descriptive and clear. Include:\n- Subject: What you want in the video (object, person, animal, scenery)\n- Context: The background/setting\n- Action: What the subject is doing\n- Style: Film style keywords (horror, noir, cartoon etc.)\n- Camera motion (optional): aerial view, tracking shot etc.\n- Composition (optional): wide shot, close-up etc.\n- Ambiance (optional): Color and lighting details\n\nMore details are available in our [prompting guide](https://blog.fal.ai/mastering-video-generation-with-veo-2-a-comprehensive-guide/).\n\nThe model supports:\n- 720p or 1080p resolution videos\n- 5-8 second duration at 24 FPS\n- Both 16:9 (landscape) and 9:16 (portrait) aspect ratios\n\nSafety filters prevent generation of inappropriate content.",
        "category": "text-to-video",
        "documentationUrl": "https://fal.ai/models/fal-ai/veo3.1/api",
        "endpointId": "fal-ai/veo3.1",
        "playgroundUrl": "https://fal.ai/models/fal-ai/veo3.1",
        "thumbnailUrl": "https://v3b.fal.media/files/b/tiger/TGTZBJyLk9HdwjB6SB90e.png"
      }
    },
    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/veo3.1": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Veo31Input"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/veo3.1/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Veo31Output"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/veo3.1/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/veo3.1/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      }
    },
