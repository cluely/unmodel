      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Generate video from image or video input using WAN 2.7 I2V model.\n\nScenarios:\n- First-frame-to-video: provide image_url\n- First+last-frame-to-video: provide image_url + end_image_url\n- Video continuation: provide video_url\n- Any scenario can include driving audio via audio_url",
        "category": "unknown",
        "documentationUrl": "https://fal.ai/models/fal-ai/wan-27-i2v/api",
        "endpointId": "fal-ai/wan-27-i2v",
        "playgroundUrl": "https://fal.ai/models/fal-ai/wan-27-i2v",
