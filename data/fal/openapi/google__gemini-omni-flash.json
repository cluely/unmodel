      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Generate a video from a text prompt using Gemini Omni Flash.\n\nFor best results, write descriptive prompts. You can control pacing\nand audio directly in the prompt (e.g. \"in a single continuous shot\",\n\"include calm background music\", \"no dialogue\"). Negative instructions\ngo in the prompt itself (e.g. \"Do not show text\").\n\nThe model supports 16:9 (landscape) and 9:16 (portrait) aspect ratios\nand 3-10 second output durations. Safety filters prevent generation of\ninappropriate content.",
        "category": "text-to-video",
        "documentationUrl": "https://fal.ai/models/fal-ai/gemini-omni-flash/api",
        "endpointId": "fal-ai/gemini-omni-flash",
        "playgroundUrl": "https://fal.ai/models/fal-ai/gemini-omni-flash",
        "thumbnailUrl": "https://v3b.fal.media/files/b/0aa0649d/TFqtIbw6p_p4rMT-44N8X.jpg"
      }
    },
