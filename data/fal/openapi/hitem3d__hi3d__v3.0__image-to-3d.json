  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "Hitem3dV30ImageTo3dInput": {
          "description": "Input for Hi3D v3.0 single-image generation.",
          "properties": {
            "enable_pbr": {
              "default": true,
              "description": "Generate PBR material maps together with the texture. Only supported (and billed) for v2.0/v2.1 and v3.0 models when enable_texture is true; ignored otherwise.",
              "title": "Enable Pbr",
              "type": "boolean"
            },
            "enable_safety_checker": {
              "default": true,
              "description": "If set to true, input images are checked for safety before processing.",
              "title": "Enable Safety Checker",
              "type": "boolean"
            },
            "enable_texture": {
              "default": true,
              "description": "Whether to generate textures in addition to geometry. When false, only the geometry mesh is generated (and billed).",
              "title": "Enable Texture",
              "type": "boolean"
            },
            "export_format": {
              "default": "glb",
              "description": "File format of the generated model.",
              "enum": [
                "glb",
                "obj",
                "stl",
                "fbx",
                "usdz"
              ],
              "title": "Export Format",
              "type": "string"
            },
            "face_count": {
              "anyOf": [
                {
                  "maximum": 5000000,
                  "minimum": 100000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Target face count. The partner recommends 2,000,000 for 2048quality and 5,000,000 for 2048master.",
              "title": "Face Count"
            },
            "image_url": {
              "description": "URL of the input image. PNG, JPEG and WebP formats are supported, up to 20MB.",
              "examples": [
                "https://storage.googleapis.com/falserverless/example_inputs/dog.png"
              ],
              "title": "Image Url",
              "type": "string"
            },
            "model": {
              "const": "hi3dv3.0",
              "default": "hi3dv3.0",
              "description": "Hi3D v3.0 model version used by this endpoint.",
              "title": "Model",
              "type": "string"
            },
            "resolution": {
              "default": "2048quality",
              "description": "Generation resolution. 2048quality is the faster default; 2048master provides the highest quality.",
              "enum": [
                "2048quality",
                "2048master"
              ],
              "title": "Resolution",
              "type": "string"
            },
            "shading": {
              "default": 0.5,
              "description": "De-shading strength.",
              "maximum": 1,
              "minimum": 0,
              "multipleOf": 0.1,
              "title": "Shading",
              "type": "number"
            }
          },
          "required": [
            "image_url"
          ],
          "title": "V3ImageTo3DInput",
          "type": "object",
          "x-fal-order-properties": [
            "model",
            "resolution",
            "enable_texture",
            "enable_pbr",
            "face_count",
            "export_format",
            "enable_safety_checker",
            "image_url",
            "shading"
          ]
        },
        "Hitem3dV30ImageTo3dOutput": {
          "description": "Output of the 3D model generation endpoints.",
          "properties": {
            "model_mesh": {
              "$ref": "#/components/schemas/File",
              "description": "Generated 3D model file."
            },
            "thumbnail": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Preview image of the generated model, when available."
            }
          },
          "required": [
            "model_mesh"
          ],
          "title": "Hitem3DOutput",
          "type": "object",
          "x-fal-order-properties": [
            "model_mesh",
            "thumbnail"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
        }
      }
    },
    "info": {
      "description": "The OpenAPI schema for the fal-ai/hitem3d/v3.0/image-to-3d queue.",
      "title": "Queue OpenAPI for fal-ai/hitem3d/v3.0/image-to-3d",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Generate a Hi3D v3.0 model from a single image.",
        "documentationUrl": "https://fal.ai/models/fal-ai/hitem3d/v3.0/image-to-3d/api",
        "endpointId": "fal-ai/hitem3d/v3.0/image-to-3d",
