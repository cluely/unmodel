{
  "metadata": {
    "category": "text-to-image",
    "date": "2026-06-02T17:49:09.083Z",
    "description": "Generate high-quality images, posters, and logos with Ideogram's latest V4.0q — producing crisp visuals with accurate text rendering, fine detail, and full creative control for polished, ready-to-use designs.",
    "display_name": "Ideogram V4.0 Text to Image",
    "group": {
      "key": "ideogram/v4",
      "label": "Text to Image"
    },
    "highlighted": false,
    "is_favorited": null,
    "kind": "inference",
    "license_type": "commercial",
    "model_url": "https://fal.run/ideogram/v4",
    "pinned": false,
    "status": "active",
    "stream_url": "https://fal.run/ideogram/v4/stream",
    "tags": [
      "realism",
      "typography",
      "stylized"
    ],
    "thumbnail_url": "https://v3b.fal.media/files/b/0a9cb567/UOWMMlOcuBA-NRLAWnP2G_8e662a91cf494675a0f6a83852cdb6e1.jpg",
    "training_endpoint_ids": [
      "ideogram/v4/trainer"
    ],
    "updated_at": "2026-07-06T12:50:57.937Z"
  },
  "openapi": {
    "components": {
      "schemas": {
        "IdeogramV4Input": {
          "properties": {
            "acceleration": {
              "default": "none",
              "description": "The acceleration level to use for the image generation.",
              "enum": [
                "none",
                "low",
                "regular",
                "high"
              ],
              "examples": [
                "none"
              ],
              "title": "Acceleration",
              "type": "string"
            },
            "enable_safety_checker": {
              "default": true,
              "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
              "title": "Enable Safety Checker",
              "type": "boolean"
            },
            "expansion_model": {
              "default": "Medium",
              "description": "Which model expands the prompt. 'None' disables prompt expansion and skips its fee; 'Medium' is fast; 'Large' uses Ideogram's Magic Prompt for the highest quality.",
              "enum": [
                "None",
                "Medium",
                "Large"
              ],
              "examples": [
                "Large"
              ],
              "title": "Expansion Model",
              "type": "string"
            },
            "image_size": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ImageSize"
                },
                {
                  "enum": [
                    "square_hd",
                    "square",
                    "portrait_4_3",
                    "portrait_16_9",
                    "landscape_4_3",
                    "landscape_16_9"
                  ],
                  "type": "string"
                }
              ],
              "default": "square_hd",
              "description": "The resolution of the generated image.",
              "title": "Image Size",
              "x-fal": {
                "max_height": 3840,
                "max_width": 3840,
                "min_height": 512,
                "min_width": 512,
                "multiple_of": 16
              }
            },
            "num_images": {
              "default": 1,
              "description": "Number of images to generate.",
              "maximum": 4,
              "minimum": 1,
              "title": "Number of Images",
              "type": "integer"
            },
            "output_format": {
              "default": "jpeg",
              "description": "The format of the generated image.",
              "enum": [
                "jpeg",
                "png"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "prompt": {
              "description": "The prompt to generate an image from.",
              "examples": [
                "A red panda perched on a mossy branch in a misty forest at sunrise"
              ],
              "title": "Prompt",
              "type": "string"
            },
            "rendering_speed": {
              "default": "BALANCED",
              "description": "The rendering speed to use. Faster speeds use fewer denoising steps.",
              "enum": [
                "TURBO",
                "BALANCED",
                "QUALITY"
              ],
              "title": "Rendering Speed",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The seed to use for generation. If not provided, a random seed will be used.",
              "title": "Seed"
            },
            "sync_mode": {
              "default": false,
              "description": "If `True`, the image is returned as a data URI and is not stored.",
              "title": "Sync Mode",
              "type": "boolean"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "TextToImageInput",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "expansion_model",
            "image_size",
            "rendering_speed",
            "acceleration",
            "num_images",
            "seed",
            "sync_mode",
            "enable_safety_checker",
            "output_format"
          ]
        },
        "IdeogramV4Output": {
          "properties": {
            "has_nsfw_concepts": {
              "description": "Whether the generated images contain NSFW concepts.",
              "items": {
                "type": "boolean"
              },
              "title": "Has Nsfw Concepts",
              "type": "array"
            },
            "images": {
              "description": "The generated images.",
              "examples": [
                [
                  {
                    "url": "https://v3b.fal.media/files/b/0a9c92b2/JLDtkHeeec2BL7ZX3PyvI_KzumHcSa.jpg"
                  }
                ]
              ],
              "items": {
                "$ref": "#/components/schemas/ImageFile"
              },
              "title": "Images",
              "type": "array"
            },
            "prompt": {
              "description": "The prompt used for generating the image.",
              "title": "Prompt",
              "type": "string"
            },
            "seed": {
              "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
              "title": "Seed",
              "type": "integer"
            },
            "timings": {
              "additionalProperties": {
                "type": "number"
              },
              "title": "Timings",
              "type": "object"
            }
          },
          "required": [
            "images",
            "timings",
            "seed",
            "has_nsfw_concepts",
            "prompt"
          ],
          "title": "IdeogramV4Output",
          "type": "object",
          "x-fal-order-properties": [
            "images",
            "timings",
            "seed",
            "has_nsfw_concepts",
            "prompt"
          ]
        },
        "ImageFile": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The height of the image",
              "title": "Height"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            },
            "width": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The width of the image",
              "title": "Width"
            }
          },
          "required": [
            "url"
          ],
          "title": "ImageFile",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ]
        },
        "ImageSize": {
          "properties": {
            "height": {
              "default": 512,
              "description": "The height of the generated image.",
              "exclusiveMinimum": 0,
              "maximum": 14142,
              "title": "Height",
              "type": "integer"
            },
            "width": {
              "default": 512,
              "description": "The width of the generated image.",
              "exclusiveMinimum": 0,
              "maximum": 14142,
              "title": "Width",
              "type": "integer"
            }
          },
          "title": "ImageSize",
          "type": "object",
          "x-fal-order-properties": [
            "width",
            "height"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
        }
      }
    },
    "info": {
      "description": "The OpenAPI schema for the fal-ai/ideogram-v4 queue.",
      "title": "Queue OpenAPI for fal-ai/ideogram-v4",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Generate an image from a text prompt using Ideogram-4.",
        "category": "text-to-image",
        "documentationUrl": "https://fal.ai/models/fal-ai/ideogram-v4/api",
        "endpointId": "fal-ai/ideogram-v4",
        "playgroundUrl": "https://fal.ai/models/fal-ai/ideogram-v4",
        "thumbnailUrl": "https://v3b.fal.media/files/b/0a9c9322/QvqFGVzFUs_y-NE3XGs3q_0426b8e8ab0447958ee18b613f55f7e8.jpg"
      }
    },
    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/ideogram-v4": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeogramV4Input"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/ideogram-v4/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/IdeogramV4Output"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/ideogram-v4/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/ideogram-v4/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      }
    },
    "security": [
      {
        "apiKeyAuth": []
      }
    ],
    "servers": [
      {
        "url": "https://queue.fal.run"
      }
    ]
  }
}
