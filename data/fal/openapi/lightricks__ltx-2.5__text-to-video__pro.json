{
  "metadata": {
    "category": "text-to-video",
    "date": "2026-08-11T14:24:06.314Z",
    "description": "LTX-2.5 is Lightricks' open-source audio-video model. This endpoint generates synchronized video and audio from a text prompt in a single pass, in a quality-optimized mode for final, high-fidelity output.",
    "display_name": "Ltx 2.5 Text to Video Fast",
    "group": {
      "key": "ltx-2.5-api",
      "label": "Text to Video (Pro)"
    },
    "highlighted": false,
    "is_favorited": null,
    "kind": "inference",
    "license_type": "commercial",
    "model_url": "https://fal.run/lightricks/ltx-2.5/text-to-video/pro",
    "pinned": false,
    "status": "active",
    "tags": [
      "stylized",
      "transform",
      "lipsync"
    ],
    "thumbnail_url": "https://v3b.fal.media/files/b/0aa5eb39/hd2sKCSz-CxI-omfTEXYi.jpg",
    "updated_at": "2026-08-14T23:11:35.262Z"
  },
  "openapi": {
    "components": {
      "schemas": {
        "Ltx25TextToVideoProInput": {
          "properties": {
            "aspect_ratio": {
              "default": "16:9",
              "description": "The aspect ratio of the generated video",
              "enum": [
                "16:9",
                "9:16"
              ],
              "title": "Aspect Ratio",
              "type": "string"
            },
            "camera_motion": {
              "anyOf": [
                {
                  "enum": [
                    "dolly_in",
                    "dolly_out",
                    "dolly_left",
                    "dolly_right",
                    "jib_up",
                    "jib_down",
                    "static",
                    "focus_shift"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional camera motion applied to the generated video.",
              "title": "Camera Motion"
            },
            "duration": {
              "default": "auto",
              "description": "The duration of the generated video in seconds, up to 10 seconds. Set to 'auto' to let the model choose the duration automatically.",
              "enum": [
                6,
                8,
                10,
                "auto"
              ],
              "title": "Duration"
            },
            "fps": {
              "default": 25,
              "description": "The frames per second of the generated video.",
              "enum": [
                24,
                25,
                50
              ],
              "title": "Frames per Second",
              "type": "integer"
            },
            "generate_audio": {
              "default": true,
              "description": "Whether to generate audio for the generated video",
              "title": "Generate Audio",
              "type": "boolean"
            },
            "prompt": {
              "description": "The prompt to use for the generated video",
              "examples": [
                "Through-the-veil shot of a bride's face during an Indian wedding ceremony, camera positioned behind the sheer red dupatta fabric, the embroidered pattern creating a textured overlay on her face, her eyes lined with kohl looking down at henna-covered hands, marigold garlands in soft background bokeh, 85mm f/1.2 focused through the fabric layer, warm tungsten and candlelight, Mira Nair Monsoon Wedding intimacy"
              ],
              "maxLength": 5000,
              "minLength": 1,
              "title": "Prompt",
              "type": "string"
            },
            "resolution": {
              "default": "1080p",
              "description": "The resolution of the generated video.",
              "enum": [
                "720p",
                "1080p"
              ],
              "title": "Resolution",
              "type": "string"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "LTXV25TextToVideoRequest",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "duration",
            "resolution",
            "aspect_ratio",
            "fps",
            "generate_audio",
            "camera_motion"
          ]
        },
        "Ltx25TextToVideoProOutput": {
          "properties": {
            "video": {
              "$ref": "#/components/schemas/VideoFile",
              "description": "The generated video file",
              "examples": [
                {
                  "content_type": "video/mp4",
                  "file_name": "EG257tf7j9UfVc-jHF8lI_0MWboc13.mp4",
                  "url": "https://v3b.fal.media/files/b/0a90dd3a/EG257tf7j9UfVc-jHF8lI_0MWboc13.mp4"
                }
              ]
            }
          },
          "required": [
            "video"
          ],
          "title": "LTXV23TextToVideoResponse",
          "type": "object",
          "x-fal-order-properties": [
            "video"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
        "VideoFile": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "duration": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The duration of the video",
              "title": "Duration"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "fps": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The FPS of the video",
              "title": "Fps"
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The height of the video",
              "title": "Height"
            },
            "num_frames": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The number of frames in the video",
              "title": "Num Frames"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            },
            "width": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The width of the video",
              "title": "Width"
            }
          },
          "required": [
            "url"
          ],
          "title": "VideoFile",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height",
            "fps",
            "duration",
            "num_frames"
          ]
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
