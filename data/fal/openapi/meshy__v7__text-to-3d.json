    "info": {
      "description": "The OpenAPI schema for the fal-ai/meshy/v7/text-to-3d queue.",
      "title": "Queue OpenAPI for fal-ai/meshy/v7/text-to-3d",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "Generate a 3D model from text using Meshy-7.\n\nSupports two modes:\n- preview: Returns untextured geometry only\n- full: Returns fully textured model (preview + refine)\n\nAlso supports smart topology (model_type='smart-topology') for the\ngeometry step and ultra_mode for higher-fidelity standard geometry.",
        "documentationUrl": "https://fal.ai/models/fal-ai/meshy/v7/text-to-3d/api",
        "endpointId": "fal-ai/meshy/v7/text-to-3d",
        "playgroundUrl": "https://fal.ai/models/fal-ai/meshy/v7/text-to-3d"
      }
    },
    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/meshy/v7/text-to-3d": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeshyV7TextTo3dInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/meshy/v7/text-to-3d/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/MeshyV7TextTo3dOutput"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/meshy/v7/text-to-3d/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
