  },
  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "Minimax_h3TextToVideoInput": {
          "properties": {
            "aspect_ratio": {
              "default": "16:9",
              "description": "The aspect ratio of the generated video.",
              "enum": [
                "21:9",
                "16:9",
                "4:3",
                "1:1",
                "3:4",
                "9:16"
              ],
              "title": "Aspect Ratio",
              "type": "string"
            },
            "duration": {
              "default": 5,
              "description": "The duration of the video in seconds.",
              "maximum": 15,
              "minimum": 5,
              "title": "Duration",
              "type": "integer"
            },
            "enable_safety_checker": {
              "default": true,
              "description": "If set to true, the safety checker will be enabled.",
              "title": "Enable Safety Checker",
              "type": "boolean"
            },
            "prompt": {
              "description": "Text prompt for video generation",
              "examples": [
                "A white kitten chases a butterfly across a sunlit garden. Gentle camera tracking, natural movement, soft afternoon light filtering through the leaves."
              ],
              "maxLength": 50000,
              "minLength": 1,
              "title": "Prompt",
              "type": "string"
            },
            "prompt_expansion_mode": {
              "anyOf": [
                {
                  "enum": [
                    "disabled",
                    "fast",
                    "balanced",
                    "quality"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "balanced",
              "description": "Which prompt expander to use. 'disabled' skips prompt expansion. 'fast' uses fal's own expansion (~1s). 'quality' always uses MiniMax's H3-Context-IR (~30s). 'balanced' uses H3-Context-IR for reference-to-video, and for image-to-video over 5s, except at 480P; all text-to-video uses fal's expansion.",
              "title": "Prompt Expansion Mode"
            },
            "resolution": {
              "default": "2K",
              "description": "The resolution of the generated video. 480P and 768P are native generation modes; 2K and 4K upscale a 768P base result.",
              "enum": [
                "480P",
                "768P",
                "2K",
                "4K"
              ],
              "title": "Resolution",
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Random seed. A random seed is selected when omitted.",
              "title": "Seed"
            },
            "sync_mode": {
              "default": false,
              "description": "Return the generated video as base64 instead of a CDN URL.",
              "title": "Sync Mode",
              "type": "boolean"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "TextToVideoHailuo03Input",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "duration",
            "resolution",
            "seed",
            "enable_safety_checker",
            "sync_mode",
            "prompt_expansion_mode",
            "aspect_ratio"
          ]
        },
        "Minimax_h3TextToVideoOutput": {
          "properties": {
            "expanded_prompt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The prompt after expansion, as sent to the model. Null when prompt expansion was disabled, left the prompt unchanged, or was performed internally by MiniMax's hosted API.",
              "title": "Expanded Prompt"
            },
            "video": {
              "$ref": "#/components/schemas/File",
              "description": "The generated video",
              "examples": [
                {
                  "content_type": "video/mp4",
                  "file_name": "--prs89fkHtWW406fmEs__NRhTqNku.mp4",
                  "file_size": 6463396,
                  "url": "https://v3b.fal.media/files/b/0aa46818/--prs89fkHtWW406fmEs__NRhTqNku.mp4"
                }
              ]
            }
          },
          "required": [
            "video"
          ],
          "title": "TextToVideoHailuo03Output",
          "type": "object",
          "x-fal-order-properties": [
            "video",
            "expanded_prompt"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
