    "updated_at": "2026-08-13T21:01:03.124Z"
  },
  "openapi": {
    "components": {
      "schemas": {
        "GptImage2EditInput": {
          "properties": {
            "image_size": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ImageSize"
                },
                {
                  "enum": [
                    "square_hd",
                    "square",
                    "portrait_4_3",
                    "portrait_16_9",
                    "landscape_4_3",
                    "landscape_16_9",
                    "auto"
                  ],
                  "type": "string"
                }
              ],
              "default": "auto",
              "description": "The size of the generated image. Use 'auto' to infer from input images.",
              "title": "Image Size"
            },
            "image_urls": {
              "description": "The URLs of the images to use as a reference for the generation. A maximum of 16 images are allowed.",
              "examples": [
                [
                  "https://v3b.fal.media/files/b/0a8691af/9Se_1_VX1wzTjjTOpWbs9_bb39c2eb-1a41-4749-b1d0-cf134abc8bbf.png"
                ]
              ],
              "items": {
                "type": "string"
              },
              "maxItems": 16,
              "title": "Image URLs",
              "type": "array"
            },
            "mask_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The URL of the mask image to use for the generation. This indicates what part of the image to edit.",
              "title": "Mask URL"
            },
            "num_images": {
              "default": 1,
              "description": "Number of images to generate",
              "examples": [
                1
              ],
              "maximum": 4,
              "minimum": 1,
              "title": "Number of Images",
              "type": "integer"
            },
            "output_format": {
              "default": "png",
              "description": "Output format for the images",
              "enum": [
                "jpeg",
                "png",
                "webp"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "prompt": {
              "description": "The prompt for image generation",
              "examples": [
                "Same workers, same beam, same lunch boxes - but they're all on their phones now. One is taking a selfie. One is on a call looking annoyed. Same danger, new priorities. A hard hat has AirPods."
              ],
              "maxLength": 32000,
              "minLength": 2,
              "title": "Prompt",
              "type": "string"
            },
            "quality": {
              "default": "high",
              "description": "Quality for the generated image. Use 'auto' to let the model pick the best quality for the prompt.",
              "enum": [
                "auto",
                "low",
                "medium",
                "high"
              ],
              "title": "Quality",
              "type": "string"
            },
            "sync_mode": {
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "title": "Sync Mode",
              "type": "boolean"
            }
          },
          "required": [
            "prompt",
            "image_urls"
          ],
          "title": "EditImageRequest",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "image_urls",
            "image_size",
            "quality",
            "num_images",
            "output_format",
            "sync_mode",
            "mask_url"
          ]
        },
        "GptImage2EditOutput": {
          "properties": {
            "images": {
              "description": "The generated images.",
              "examples": [
                [
                  {
                    "content_type": "image/png",
                    "file_name": "yUt7tifLSbg1WzWWgfj2o.png",
                    "height": 1024,
                    "url": "https://v3b.fal.media/files/b/0a8691b0/yUt7tifLSbg1WzWWgfj2o.png",
                    "width": 1024
                  }
                ]
              ],
              "items": {
                "$ref": "#/components/schemas/ImageFile"
              },
              "title": "Images",
              "type": "array"
            }
          },
          "required": [
            "images"
          ],
          "title": "EditImageResponse",
          "type": "object",
          "x-fal-order-properties": [
            "images"
          ]
        },
        "ImageFile": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The height of the image",
              "title": "Height"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            },
            "width": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The width of the image",
              "title": "Width"
            }
          },
          "required": [
            "url"
          ],
          "title": "ImageFile",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ]
        },
        "ImageSize": {
          "properties": {
            "height": {
              "default": 512,
              "description": "The height of the generated image.",
              "exclusiveMinimum": 0,
              "maximum": 14142,
              "title": "Height",
              "type": "integer"
            },
            "width": {
              "default": 512,
              "description": "The width of the generated image.",
              "exclusiveMinimum": 0,
              "maximum": 14142,
              "title": "Width",
              "type": "integer"
            }
          },
          "title": "ImageSize",
          "type": "object",
          "x-fal-order-properties": [
            "width",
            "height"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
        }
      }
    },
    "info": {
      "description": "The OpenAPI schema for the fal-ai/gpt-image-2/edit queue.",
