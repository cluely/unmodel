  "metadata": {
    "category": "image-to-image",
    "date": "2026-08-11T22:38:56.212Z",
    "description": "Professional generative image upscaling powered by Topaz Labs. Wonder 3.5 leads the range, with Redefine for prompt-guided detail and Recovery for extreme low-resolution sources. Best for rebuilding sharp detail in small or blurry images.",
    "display_name": "Topaz Upscale Image Generative",
    "group": {
      "key": "topaz-upscale-image",
      "label": "Upscale Image Generative  ( Wonder 3.5 )"
    },
    "highlighted": false,
    "is_favorited": null,
    "kind": "inference",
    "license_type": "commercial",
    "model_url": "https://fal.run/topaz/upscale/image/generative",
    "pinned": false,
    "status": "active",
    "tags": [
      "upscale",
      "image"
    ],
    "thumbnail_url": "https://v3b.fal.media/files/b/0aa5f6e8/wn3JpJcY1I824uEdijtAy.jpg",
    "updated_at": "2026-08-31T17:55:19.832Z"
  },
  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
        "TopazUpscaleImageGenerativeInput": {
          "properties": {
            "autoprompt": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Enable automatic prompt generation for generative upscaling. Applies to Redefine model only.",
              "title": "Autoprompt"
            },
            "creativity": {
              "anyOf": [
                {
                  "maximum": 6,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Creativity level for generative upscaling (1-6). Higher values produce more creative/hallucinated details. Applies to Redefine model only.",
              "title": "Creativity"
            },
            "crop_to_fill": {
              "default": false,
              "title": "Crop To Fill",
              "type": "boolean"
            },
            "denoise": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Denoising level (0.0-1.0). Applies to Redefine model only.",
              "title": "Denoise"
            },
            "detail": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Detail recovery level (0.0-1.0). Applies to Recovery V2 model only.",
              "title": "Detail"
            },
            "enhancement_strength": {
              "anyOf": [
                {
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Enhancement strength for generative upscaling. Applies to Wonder 3 and Wonder 3.5 models. When omitted, Topaz auto-configures it.",
              "title": "Enhancement Strength"
            },
            "face_enhancement": {
              "default": true,
              "description": "Whether to apply face enhancement to the image.",
              "title": "Face Enhancement",
              "type": "boolean"
            },
            "face_enhancement_creativity": {
              "default": 0,
              "description": "Creativity level for face enhancement. 0.0 means no creativity, 1.0 means maximum creativity. Ignored if face enhancement is disabled.",
              "maximum": 1,
              "minimum": 0,
              "title": "Face Enhancement Creativity",
              "type": "number"
            },
            "face_enhancement_strength": {
              "default": 0.8,
              "description": "Strength of the face enhancement. 0.0 means no enhancement, 1.0 means maximum enhancement. Ignored if face enhancement is disabled.",
              "maximum": 1,
              "minimum": 0,
              "title": "Face Enhancement Strength",
              "type": "number"
            },
            "image_url": {
              "description": "Url of the image to be upscaled",
              "examples": [
                "https://storage.googleapis.com/falserverless/model_tests/codeformer/codeformer_poor_1.jpeg"
              ],
              "minLength": 1,
              "title": "Image Url",
              "type": "string"
            },
            "model": {
              "default": "Wonder 3",
              "description": "Generative upscaling model. Wonder 3.5 is the latest Wonder with finer detail and fewer repetitive patterns; Wonder 3 is Topaz's most advanced generative realism model (Wonder 2/Wonder are earlier generations); Recover 3 rebuilds natural detail; Standard MAX is high-quality precision-leaning upscaling; Redefine adds prompt-guided creative detail; Recovery and Recovery V2 rebuild extreme low-resolution images.",
              "enum": [
                "Wonder 3.5",
                "Wonder 3",
                "Wonder 2",
                "Wonder",
                "Recover 3",
                "Standard MAX",
                "Redefine",
                "Recovery V2",
                "Recovery"
              ],
              "title": "Model",
              "type": "string"
            },
            "output_format": {
              "default": "jpeg",
              "description": "Output format of the upscaled image.",
              "enum": [
                "jpeg",
                "png"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "prompt": {
              "anyOf": [
                {
                  "maxLength": 1024,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Text prompt to guide generative upscaling (max 1024 chars). Applies to Redefine model only.",
              "title": "Prompt"
            },
            "sharpen": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sharpening level (0.0-1.0). Applies to Redefine model only.",
              "title": "Sharpen"
            },
            "subject_detection": {
              "default": "All",
              "description": "Subject detection mode for the image enhancement. Applies to Wonder 3, Recovery and Recovery V2 models.",
              "enum": [
                "All",
                "Foreground",
                "Background"
              ],
              "title": "Subject Detection",
              "type": "string"
            },
            "texture": {
              "anyOf": [
                {
                  "maximum": 5,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Texture detail level for generative upscaling (1-5). Applies to Redefine model only.",
              "title": "Texture"
            },
            "upscale_factor": {
              "default": 2,
              "description": "Factor to upscale the image by (e.g. 2.0 doubles width and height)",
              "maximum": 4,
              "minimum": 1,
              "title": "Upscale Factor",
              "type": "number"
            }
          },
          "required": [
            "image_url"
          ],
          "title": "ImageGenerativeUpscaleRequest",
          "type": "object",
          "x-fal-order-properties": [
            "image_url",
            "model",
            "upscale_factor",
            "crop_to_fill",
            "output_format",
            "subject_detection",
            "face_enhancement",
            "face_enhancement_creativity",
            "face_enhancement_strength",
            "enhancement_strength",
            "creativity",
            "texture",
            "prompt",
            "autoprompt",
            "sharpen",
            "denoise",
            "detail"
          ]
        },
        "TopazUpscaleImageGenerativeOutput": {
          "properties": {
            "image": {
              "$ref": "#/components/schemas/File",
              "description": "The upscaled image."
            }
          },
          "required": [
            "image"
          ],
          "title": "ImageUpscaleOutput",
          "type": "object",
          "x-fal-order-properties": [
            "image"
          ]
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
        }
      }
    },
    "info": {
      "description": "The OpenAPI schema for the fal-ai/topaz/upscale/image/generative queue.",
      "title": "Queue OpenAPI for fal-ai/topaz/upscale/image/generative",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "# Topaz Generative Image Upscale (Wonder)\n\nGenerative upscaling that reconstructs and invents detail the\nsource no longer has.\n\n## Models\n- **Wonder 3** — Topaz's most advanced generative realism model\n(default).\n- **Wonder** — one-click repair for low/medium resolution images.\n- **Standard MAX** — high-quality upscaling with generative help.\n- **Redefine** — prompt-guided creative upscaling (`prompt`,\n`creativity`, `texture`).\n- **Recovery / Recovery V2** — rebuild extreme low-resolution\nimages.",
        "category": "image-to-image",
        "documentationUrl": "https://fal.ai/models/fal-ai/topaz/upscale/image/generative/api",
        "endpointId": "fal-ai/topaz/upscale/image/generative",
        "playgroundUrl": "https://fal.ai/models/fal-ai/topaz/upscale/image/generative",
        "thumbnailUrl": "https://v3b.fal.media/files/b/0aa425fe/OIhymtZthfxjHCL_-qOsx.jpg"
      }
    },
    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/topaz/upscale/image/generative": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopazUpscaleImageGenerativeInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/topaz/upscale/image/generative/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/TopazUpscaleImageGenerativeOutput"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/topaz/upscale/image/generative/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/topaz/upscale/image/generative/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      }
    },
    "security": [
      {
        "apiKeyAuth": []
