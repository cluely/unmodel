      "x-fal-metadata": {
        "about": "# Topaz Precision Image Upscale (Gigapixel)\n\nClassic (non-generative) upscaling that stays faithful to the\nsource pixels.\n\n## Models\n- **Standard V2** — general-purpose, fits most photos.\n- **High Fidelity V2** — preserves fine detail in professional\nshots.\n- **Low Resolution V2** — recovers compressed, low-quality sources.\n- **CGI** — artwork and rendered graphics.\n- **Text Refine** — keeps text and shapes crisp.",
        "category": "video-to-video",
        "documentationUrl": "https://fal.ai/models/fal-ai/topaz/upscale/image/precision/api",
        "endpointId": "fal-ai/topaz/upscale/image/precision",
        "playgroundUrl": "https://fal.ai/models/fal-ai/topaz/upscale/image/precision",
        "thumbnailUrl": "https://v3b.fal.media/files/b/0aa5f11c/rfYtZC9zq_ABqGGzEdY2U.jpg"
      }
    },
