    "info": {
      "description": "The OpenAPI schema for the fal-ai/topaz/upscale/video/generative queue.",
      "title": "Queue OpenAPI for fal-ai/topaz/upscale/video/generative",
      "version": "1.0.0",
      "x-fal-metadata": {
        "about": "# Topaz Generative Video Upscale (Starlight)\n\nDiffusion-based restoration and upscaling that regenerates detail\nthe source no longer has.\n\n## Models\n- **Starlight Precise 2.6** — realism pass for AI-generated video.\n- **Starlight HQ** — maximum quality on high-resolution sources.\n- **Starlight Mini** — diffusion restoration for archival footage.\n- **Starlight Sharp** — fast restoration with sharper detail.\n- **Starlight Fast 2** — the fastest, cheapest diffusion upscaler.\n\nVideos are limited to 5 minutes. `target_fps` enables Apollo frame\ninterpolation only when it differs from the source FPS.",
        "category": "video-to-video",
        "documentationUrl": "https://fal.ai/models/fal-ai/topaz/upscale/video/generative/api",
        "endpointId": "fal-ai/topaz/upscale/video/generative",
        "playgroundUrl": "https://fal.ai/models/fal-ai/topaz/upscale/video/generative",
        "thumbnailUrl": "https://v3b.fal.media/files/b/0aa426f5/yQi9dMQ-_Op2aGZ2eb4q2.jpg"
      }
    },
    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/topaz/upscale/video/generative": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopazUpscaleVideoGenerativeInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/topaz/upscale/video/generative/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/TopazUpscaleVideoGenerativeOutput"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/topaz/upscale/video/generative/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/topaz/upscale/video/generative/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      }
    },
