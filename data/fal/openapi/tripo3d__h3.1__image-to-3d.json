  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "ModelUrls": {
          "description": "3D model download URLs",
          "properties": {
            "base_model": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Base (untextured) model"
            },
            "fbx": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "FBX format 3D model",
              "title": "FBX"
            },
            "glb": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "GLB format 3D model",
              "title": "GLB"
            },
            "pbr_model": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "PBR-textured model",
              "title": "PBR Model"
            }
          },
          "title": "ModelUrls",
          "type": "object",
          "x-fal-order-properties": [
            "glb",
            "fbx",
            "base_model",
            "pbr_model"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
        "Tripo3dH31ImageTo3dInput": {
          "description": "Input for Image to 3D generation using full-featured models (H3.1, v2.5).",
          "properties": {
            "auto_size": {
              "default": false,
              "description": "Auto-scale the model to real-world dimensions (meters).",
              "title": "Auto Size",
              "type": "boolean"
            },
            "face_limit": {
              "anyOf": [
                {
                  "maximum": 2000000,
                  "minimum": 1000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Target number of faces for the generated mesh. If not set, the model adaptively determines the count.",
              "title": "Face Limit"
            },
            "geometry_quality": {
              "default": "standard",
              "description": "Quality level for geometry.",
              "enum": [
                "standard",
                "detailed"
              ],
              "title": "Geometry Quality",
              "type": "string"
            },
            "image_url": {
              "description": "URL of the input image for 3D model creation.",
              "examples": [
                "https://v3b.fal.media/files/b/zebra/3osHJDI8IZ2wl6sGtEUeB_image.png"
              ],
              "title": "Image Url",
              "type": "string"
            },
            "model_seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Seed for geometry generation reproducibility.",
              "title": "Model Seed"
            },
            "orientation": {
              "default": "default",
              "description": "Model orientation. 'align_image' auto-rotates to match the input image.",
              "enum": [
                "default",
                "align_image"
              ],
              "title": "Orientation",
              "type": "string"
            },
            "pbr": {
              "default": true,
              "description": "Whether to generate PBR (Physically Based Rendering) materials. If true, texture is also enabled.",
              "title": "Pbr",
              "type": "boolean"
            },
            "quad": {
              "default": false,
              "description": "Generate quad (4-sided) mesh topology instead of triangles. When Tripo emits FBX bytes for quad output, the returned model file is FBX.",
              "title": "Quad",
              "type": "boolean"
            },
            "texture": {
              "default": true,
              "description": "Whether to generate textures for the model.",
              "title": "Texture",
              "type": "boolean"
            },
            "texture_alignment": {
              "default": "original_image",
              "description": "How textures are aligned. 'original_image' aligns to input image, 'geometry' aligns to generated geometry.",
              "enum": [
                "original_image",
                "geometry"
              ],
              "title": "Texture Alignment",
              "type": "string"
            },
            "texture_quality": {
              "default": "standard",
              "description": "Quality level for textures. 'detailed' produces higher-resolution textures.",
              "enum": [
                "standard",
                "detailed"
              ],
              "title": "Texture Quality",
              "type": "string"
            },
            "texture_seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Seed for texture generation reproducibility.",
              "title": "Texture Seed"
            }
          },
          "required": [
            "image_url"
          ],
          "title": "FullImageTo3DInput",
          "type": "object",
          "x-fal-order-properties": [
            "image_url",
            "face_limit",
            "texture",
            "pbr",
            "model_seed",
            "texture_seed",
            "texture_quality",
            "geometry_quality",
            "texture_alignment",
            "auto_size",
            "orientation",
            "quad"
          ]
        },
        "Tripo3dH31ImageTo3dOutput": {
          "description": "Output for Tripo3D generation",
          "properties": {
            "model_mesh": {
              "$ref": "#/components/schemas/File",
              "description": "Generated 3D model file. May be GLB or FBX depending on Tripo output."
            },
            "model_urls": {
              "$ref": "#/components/schemas/ModelUrls",
              "description": "URLs for different 3D model variants.",
              "title": "Model URLs"
            },
            "rendered_image": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Preview render of the generated 3D model."
            }
          },
          "required": [
            "model_mesh",
            "model_urls"
          ],
          "title": "Tripo3DOutput",
          "type": "object",
          "x-fal-order-properties": [
            "model_mesh",
            "model_urls",
            "rendered_image"
          ]
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
          "name": "Authorization",
          "type": "apiKey"
        }
      }
    },
