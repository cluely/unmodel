    "openapi": "3.0.4",
    "paths": {
      "/fal-ai/tripo3d/h3.1/image-to-3d": {
        "post": {
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tripo3dH31ImageTo3dInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      },
      "/fal-ai/tripo3d/h3.1/image-to-3d/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Tripo3dH31ImageTo3dOutput"
                  }
                }
              },
              "description": "Result of the request."
            }
          }
        }
      },
      "/fal-ai/tripo3d/h3.1/image-to-3d/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "description": "Whether the request was cancelled successfully.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                }
              },
              "description": "The request was cancelled."
            }
          }
        }
      },
      "/fal-ai/tripo3d/h3.1/image-to-3d/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "in": "path",
              "name": "request_id",
              "required": true,
              "schema": {
                "description": "Request ID",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "logs",
              "required": false,
              "schema": {
                "description": "Whether to include logs (`1`) in the response or not (`0`).",
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              },
              "description": "The request status."
            }
          }
        }
      }
    },
