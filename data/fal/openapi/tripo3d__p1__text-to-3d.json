  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "ModelUrls": {
          "description": "3D model download URLs",
          "properties": {
            "base_model": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Base (untextured) model"
            },
            "fbx": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "FBX format 3D model",
              "title": "FBX"
            },
            "glb": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "GLB format 3D model",
              "title": "GLB"
            },
            "pbr_model": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "PBR-textured model",
              "title": "PBR Model"
            }
          },
          "title": "ModelUrls",
          "type": "object",
          "x-fal-order-properties": [
            "glb",
            "fbx",
            "base_model",
            "pbr_model"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
        "Tripo3dP1TextTo3dInput": {
          "description": "Input for Text to 3D generation using the P1 model.\n\nP1 is optimized for clean low-poly mesh generation in ~2 seconds.\nIt supports a restricted parameter set compared to H3.1/v2.5.",
          "properties": {
            "face_limit": {
              "anyOf": [
                {
                  "maximum": 20000,
                  "minimum": 48,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Target number of faces for the generated mesh. If not set, the model adaptively determines the count.",
              "title": "Face Limit"
            },
            "model_seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Seed for geometry generation reproducibility.",
              "title": "Model Seed"
            },
            "prompt": {
              "description": "Text description of the 3D object to generate. Maximum 1024 characters.",
              "examples": [
                "A simple wooden chair"
              ],
              "maxLength": 1024,
              "title": "Prompt",
              "type": "string"
            },
            "texture": {
              "default": true,
              "description": "Whether to generate textures for the model.",
              "title": "Texture",
              "type": "boolean"
            }
          },
          "required": [
            "prompt"
          ],
          "title": "P1TextTo3DInput",
          "type": "object",
          "x-fal-order-properties": [
            "prompt",
            "face_limit",
            "texture",
            "model_seed"
          ]
        },
        "Tripo3dP1TextTo3dOutput": {
          "description": "Output for Tripo3D generation",
          "properties": {
            "model_mesh": {
              "$ref": "#/components/schemas/File",
              "description": "Generated 3D model file. May be GLB or FBX depending on Tripo output."
            },
            "model_urls": {
              "$ref": "#/components/schemas/ModelUrls",
              "description": "URLs for different 3D model variants.",
              "title": "Model URLs"
            },
            "rendered_image": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Preview render of the generated 3D model."
            }
          },
          "required": [
            "model_mesh",
            "model_urls"
          ],
          "title": "Tripo3DOutput",
          "type": "object",
          "x-fal-order-properties": [
            "model_mesh",
            "model_urls",
            "rendered_image"
          ]
        }
      },
      "securitySchemes": {
        "apiKeyAuth": {
          "description": "Fal Key",
          "in": "header",
