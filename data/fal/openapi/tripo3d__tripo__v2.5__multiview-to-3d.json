  "openapi": {
    "components": {
      "schemas": {
        "File": {
          "properties": {
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file.",
              "examples": [
                "image/png"
              ],
              "title": "Content Type"
            },
            "file_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name"
            },
            "file_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes.",
              "examples": [
                4404019
              ],
              "title": "File Size"
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "File",
          "type": "object",
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size"
          ]
        },
        "QueueStatus": {
          "properties": {
            "cancel_url": {
              "description": "The cancel url.",
              "type": "string"
            },
            "logs": {
              "additionalProperties": true,
              "description": "The logs.",
              "type": "object"
            },
            "metrics": {
              "additionalProperties": true,
              "description": "The metrics.",
              "type": "object"
            },
            "queue_position": {
              "description": "The queue position.",
              "type": "integer"
            },
            "request_id": {
              "description": "The request id.",
              "type": "string"
            },
            "response_url": {
              "description": "The response url.",
              "type": "string"
            },
            "status": {
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ],
              "type": "string"
            },
            "status_url": {
              "description": "The status url.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "request_id"
          ],
          "type": "object"
        },
        "TripoV25MultiviewTo3dInput": {
          "properties": {
            "auto_size": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": false,
              "description": "Automatically scale the model to real-world dimensions, with the unit in meters. The default value is False.",
              "title": "Auto Size"
            },
            "back_image_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Back view image of the object.",
              "examples": [
                "https://platform.tripo3d.ai/assets/back-6vq1a8L4.jpg"
              ],
              "title": "Back Image Url"
            },
            "face_limit": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Limits the number of faces on the output model. If this option is not set, the face limit will be adaptively determined.",
              "title": "Face Limit"
            },
            "front_image_url": {
              "description": "Front view image of the object.",
              "examples": [
                "https://platform.tripo3d.ai/assets/front-235queJB.jpg"
              ],
              "title": "Front Image Url",
              "type": "string"
            },
            "left_image_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Left view image of the object.",
              "examples": [
                "https://platform.tripo3d.ai/assets/left-Nfdj2U8P.jpg"
              ],
              "title": "Left Image Url"
            },
            "orientation": {
              "anyOf": [
                {
                  "enum": [
                    "default",
                    "align_image"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "default",
              "description": "Set orientation=align_image to automatically rotate the model to align the original image. The default value is default.",
              "title": "Orientation"
            },
            "pbr": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": false,
              "description": "A boolean option to enable pbr. The default value is True, set False to get a model without pbr. If this option is set to True, texture will be ignored and used as True.",
              "title": "Pbr"
            },
            "quad": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": false,
              "description": "Set True to enable quad mesh output (extra $0.05 per generation). If quad=True and face_limit is not set, the default face_limit will be 10000. Note: Enabling this option will force the output to be an FBX model.",
              "title": "Quad"
            },
            "right_image_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Right view image of the object.",
              "examples": [
                "https://platform.tripo3d.ai/assets/right-hj57H4if.jpg"
              ],
              "title": "Right Image Url"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "This is the random seed for model generation. The seed controls the geometry generation process, ensuring identical models when the same seed is used. This parameter is an integer and is randomly chosen if not set.",
              "title": "Seed"
            },
            "style": {
              "anyOf": [
                {
                  "enum": [
                    "person:person2cartoon",
                    "object:clay",
                    "object:steampunk",
                    "animal:venom",
                    "object:barbie",
                    "object:christmas",
                    "gold",
                    "ancient_bronze"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "deprecated": true,
              "description": "[DEPRECATED] Defines the artistic style or transformation to be applied to the 3D model, altering its appearance according to preset options (extra $0.05 per generation). Omit this option to keep the original style and apperance.",
              "title": "Style"
            },
            "texture": {
              "default": "standard",
              "description": "An option to enable texturing. Default is 'standard', set 'no' to get a model without any textures, and set 'HD' to get a model with hd quality textures.",
              "enum": [
                "no",
                "standard",
                "HD"
              ],
              "title": "Texture",
              "type": "string"
            },
            "texture_alignment": {
              "anyOf": [
                {
                  "enum": [
                    "original_image",
                    "geometry"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "original_image",
              "description": "Determines the prioritization of texture alignment in the 3D model. The default value is original_image.",
              "title": "Texture Alignment"
            },
            "texture_seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "This is the random seed for texture generation. Using the same seed will produce identical textures. This parameter is an integer and is randomly chosen if not set. If you want a model with different textures, please use same seed and different texture_seed.",
              "title": "Texture Seed"
            }
          },
          "required": [
            "front_image_url"
          ],
          "title": "MultiviewTo3dInput",
          "type": "object",
          "x-fal-order-properties": [
            "seed",
            "face_limit",
            "pbr",
            "texture",
            "texture_seed",
            "auto_size",
            "style",
            "quad",
            "texture_alignment",
            "orientation",
            "front_image_url",
            "left_image_url",
            "back_image_url",
            "right_image_url"
          ]
        },
        "TripoV25MultiviewTo3dOutput": {
          "properties": {
            "base_model": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Base model"
            },
            "model_mesh": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Model",
              "examples": [
                {
                  "content_type": "application/octet-stream",
                  "file_size": 6744644,
                  "url": "https://v3.fal.media/files/zebra/NA4WkhbpI-XdOIFc4cDIk_tripo_model_812c3a8a-6eb3-4c09-9f40-0563d27ae7ea.glb"
                }
              ]
            },
            "pbr_model": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Pbr model"
            },
            "rendered_image": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/File"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A preview image of the model",
              "examples": [
                {
                  "content_type": "image/webp",
                  "file_size": 13718,
                  "url": "https://v3.fal.media/files/panda/zDTAHqp8ifMOT3upZ1xJv_legacy.webp"
                }
              ]
            },
            "task_id": {
              "description": "The task id of the 3D model generation.",
              "title": "Task Id",
              "type": "string"
            }
          },
          "required": [
            "task_id"
          ],
          "title": "Tripo3dOutput",
          "type": "object",
          "x-fal-order-properties": [
            "task_id",
            "model_mesh",
            "base_model",
            "pbr_model",
            "rendered_image"
          ]
        }
      },
