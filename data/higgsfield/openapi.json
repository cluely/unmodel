    "/requests/{request_id}": {
      "delete": {
        "description": "Delete a finished request's input and output files, prompt and parameters now, regardless of its retention. Billing records are kept. Repeating the call returns the same response.",
        "operationId": "delete_request",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedRequest"
                }
              }
            },
            "description": "The request data was deleted."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API credentials."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request does not exist or belongs to another account."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is still queued or in progress."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Deletion is temporarily unavailable. Retry later."
          }
        },
        "summary": "Delete request data",
        "tags": [
          "Requests"
        ]
      }
    },
    "/requests/{request_id}/cancel": {
      "post": {
        "description": "Cancel a request that has not started processing. A successful response has no body.",
        "operationId": "cancel_request",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "The request was canceled."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request has already started and can no longer be canceled."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API credentials."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request does not exist or belongs to another account."
          }
        },
        "summary": "Cancel a queued request",
        "tags": [
          "Requests"
        ]
      }
    },
    "/requests/{request_id}/status": {
      "get": {
        "description": "Retrieve the current state and output of a generation request.",
        "operationId": "get_request_status",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestStatus"
                }
              }
            },
            "description": "Current request state and output, when available."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API credentials."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request does not exist or belongs to another account."
          }
        },
        "summary": "Get request status",
        "tags": [
          "Requests"
        ]
      }
    }
  },
  "security": [
    {
      "authKey": []
    }
  ],
  "servers": [
