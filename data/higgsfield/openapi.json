{
  "components": {
    "schemas": {
      "DeletedRequest": {
        "properties": {
          "request_id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "deleted"
            ],
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "status"
        ],
        "title": "DeletedRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Error response",
        "type": "object"
      },
      "MediaOutput": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "Media output",
        "type": "object"
      },
      "RequestStatus": {
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/MediaOutput"
          },
          "audios": {
            "items": {
              "$ref": "#/components/schemas/MediaOutput"
            },
            "type": "array"
          },
          "cancel_url": {
            "format": "uri",
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "description": "When the request data is deleted and output URLs stop working. Present once the request has finished.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/MediaOutput"
            },
            "type": "array"
          },
          "request_id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "in_progress",
              "nsfw",
              "failed",
              "completed",
              "canceled"
            ],
            "title": "Status",
            "type": "string"
          },
          "status_url": {
            "format": "uri",
            "type": "string"
          },
          "video": {
            "$ref": "#/components/schemas/MediaOutput"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "title": "Request",
        "type": "object"
      }
    },
    "securitySchemes": {
      "authKey": {
        "description": "Use `Key {api_key_id}:{api_key_secret}`.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Submit generation requests and retrieve their status and outputs.",
    "title": "Higgsfield API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/higgsfield-ai/soul/standard": {
      "post": {
        "description": "Submit an asynchronous generation request to `/higgsfield-ai/soul/standard`. The response includes request metadata for status tracking and cancellation.",
        "operationId": "post_higgsfield_ai_soul_standard",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "aspect_ratio": {
                    "default": "4:3",
                    "enum": [
                      "1:1",
                      "4:3",
                      "3:4",
                      "3:2",
                      "2:3",
                      "5:4",
                      "4:5",
                      "16:9",
                      "9:16",
                      "21:9"
                    ],
                    "title": "Aspect Ratio",
                    "type": "string"
                  },
                  "num_images": {
                    "default": 1,
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "prompt": {
                    "title": "Prompt",
                    "type": "string"
                  },
                  "resolution": {
                    "default": "2K",
                    "enum": [
                      "2K",
                      "4K"
                    ]
                  }
                },
                "required": [
                  "prompt"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestStatus"
                }
              }
            },
            "description": "The request status"
          }
        },
        "summary": "Create higgsfield-ai soul standard",
        "tags": [
          "Soul"
        ]
      }
    },
