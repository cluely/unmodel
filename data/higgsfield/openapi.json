                    "type": "number"
                  },
                  "duration": {
                    "default": 5,
                    "enum": [
                      5,
                      10
                    ],
                    "title": "Duration",
                    "type": "integer"
                  },
                  "image_url": {
                    "format": "uri",
                    "title": "Image URL",
                    "type": "string"
                  },
                  "negative_prompt": {
                    "default": "",
                    "title": "Negative Prompt",
                    "type": "string"
                  },
                  "prompt": {
                    "title": "Prompt",
                    "type": "string"
                  }
                },
                "required": [
                  "prompt",
                  "image_url"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestStatus"
                }
              }
            },
            "description": "The request status"
          }
        },
        "summary": "Create kling-video v2.5-turbo pro image-to-video",
        "tags": [
          "Kling Video"
        ]
